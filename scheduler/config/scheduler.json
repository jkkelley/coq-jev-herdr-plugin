{
  "schema_version": "1.1.0",
  "mode": "${ENV:COQ_SCHED_MODE}",
  "seat": "scheduler",
  "herdr_session": "${ENV:COQ_HERDR_SESSION}",
  "repo": "${ENV:COQ_SCHED_REPO}",
  "host_repo": "${ENV:COQ_REPO}",
  "state_dir": "${ENV:COQ_SCHED_STATE_DIR}",
  "routes_file": "${repo}/factory/config/routes.json",
  "policies_file": "${repo}/factory/config/policies.json",
  "flow_file": "${repo}/factory/config/flow.json",
  "roles_dir": "${repo}/roles",
  "playbooks_dir": "${host_repo}/playbooks",
  "halt_flag": "${state_dir}/HALT",
  "drain_seconds": 30,
  "intake.poll_seconds": 2,
  "intake.roots": [
    "${repo}/events",
    "${HOME}/.treehouse/coq-jev-herdr-plugin-*/*/coq-jev-herdr-plugin/events"
  ],
  "intake.since": "now",
  "intake.runner_seats": ["scheduler", "route-runner"],
  "seat.busy_regex": "… \\([0-9]+[ms]|Running…",
  "seat.done_regex": " for [0-9]+[hms].*done [0-9]{2}:[0-9]{2}Z",
  "seat.read_lines": 12,
  "seat.cap_wait_seconds": 600,
  "seat.absent_wait_seconds": 1800,
  "seat.idle_seconds": 120,
  "retry.max_attempts": 5,
  "retry.base_seconds": 5,
  "retry.factor": 2,
  "retry.max_seconds": 300,
  "retry.jitter": 0.2,
  "jobs.in_flight": 4,
  "jobs.keep_days": 7,
  "wake.ack_seconds": {
    "architect": 120,
    "interface-agent": 90,
    "merger": 120,
    "monitor": 90,
    "orchestrator": 120,
    "player": 90,
    "reviewer": 120,
    "tester": 180,
    "worker": 120
  },
  "wake.max_attempts": 3,
  "stall.deadline_seconds": {
    "pr.opened": 600,
    "test.passed": 600,
    "test.failed": 900,
    "review.passed": 600,
    "review.changes": 900,
    "merge.conflict": 900,
    "merged": 900
  },
  "stall.visible_within_seconds": 900,
  "belt.file": "${state_dir}/belt",
  "belt.stale_seconds": 60,
  "executor.socket": "${ENV:XDG_RUNTIME_DIR}/coq-scheduler/executor.sock",
  "executor.dial_seconds": 5,
  "executor.health_seconds": 2,
  "control.socket": "${state_dir}/scheduler.sock",
  "notify.min_code": 500,
  "housekeeping.queue_sweep_seconds": 60,
  "housekeeping.glass_sweep_seconds": 15,
  "housekeeping.prune_seconds": 3600,
  "shadow.dir": "${state_dir}/shadow",
  "shadow.parity_min_records": 200,
  "log.level": "info",
  "runtime.image": "coq-scheduler:1",
  "runtime.image_digest": "${ENV:COQ_SCHED_IMAGE_DIGEST}",
  "runtime.memory": "256m",
  "runtime.container_name": "coq-scheduler"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coq:report:loop:schema:loop",
  "title": "factory board entry",
  "description": "The one data entry the factory board page draws (WO-20261011-616c). loop.sh collect emits it from the records, the ticket files and the herdr pane list, and loop.sh render refuses anything that does not validate. It carries no project name and no absolute path: every string is a `text` and `text` refuses a leading-slash path. Its shape is the DATA block of the owner-locked design iteration 5 (report/loop/design), with the nine stations and the kickback lanes moved from page constants into the entry so a real collect derives them from roles/*.json and factory/config/routes.json. The $id is a urn on purpose: the other schemas here use a relative id like coq/factory/schema/x.json, and with that id python-jsonschema joined each #/$defs ref onto it twice and raised RefResolutionError on the first fixture (2026-10-11 UTC, WO-20261011-616c); this schema is the first to use $ref, a urn base resolves fragment refs cleanly. Cost: its id differs in style from its neighbours.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "number",
    "at",
    "actor",
    "state",
    "headline",
    "poll_seconds",
    "stations",
    "kickbacks",
    "lines",
    "board",
    "legend",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "number": {
      "type": "integer",
      "minimum": 1,
      "description": "the build count; watch raises it each time the data changes"
    },
    "at": { "$ref": "#/$defs/utc" },
    "actor": { "$ref": "#/$defs/text" },
    "state": { "$ref": "#/$defs/text" },
    "headline": { "$ref": "#/$defs/text" },
    "poll_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30,
      "description": "how often the open page asks for data.json; read from config"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/station" }
    },
    "kickbacks": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/kickback" }
    },
    "lines": {
      "type": "array",
      "maxItems": 80,
      "items": { "$ref": "#/$defs/line" }
    },
    "glass": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/glassline" },
      "description": "one row per break glass request (WO-20261011-4562), newest last: the records of one request id folded to the state the latest record says; optional so an entry drawn before break glass existed still validates"
    },
    "board_title": {
      "$ref": "#/$defs/text",
      "description": "the build board's heading when the design's own wording does not fit; optional"
    },
    "board": {
      "type": "array",
      "maxItems": 120,
      "items": { "$ref": "#/$defs/boardrow" }
    },
    "legend": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/text" }]
      }
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "the document title, when the view is not the factory board (WO-20261011-ceea); optional"
    },
    "label": {
      "$ref": "#/$defs/text",
      "description": "the word before the build number in the eyebrow, the board's LOOP; optional"
    },
    "legend_title": {
      "$ref": "#/$defs/text",
      "description": "the legend fold's heading when the design's wording does not fit; optional"
    },
    "legend_open": {
      "type": "boolean",
      "description": "the legend fold starts open; optional"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": {
          "type": "string",
          "maxLength": 400,
          "pattern": "^https?://.*\\{id\\}"
        }
      },
      "description": "where a graph node id at the head of a station part links to; {id} stands for the id; optional"
    },
    "key": {
      "type": "array",
      "maxItems": 6,
      "description": "replaces the key block when the view is not the factory board: groups of [pill:status | dot:part | ks:swatch, label, meaning]; optional",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eyebrow", "items"],
        "properties": {
          "eyebrow": { "$ref": "#/$defs/text" },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "type": "string", "pattern": "^(pill|dot|ks):[a-z-]+$" },
                { "$ref": "#/$defs/text" },
                { "$ref": "#/$defs/text" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "source": {
          "type": "string",
          "maxLength": 200000,
          "description": "mermaid source; drawn when mermaid loads, shown as text when it does not"
        }
      },
      "description": "one embedded diagram, a fold under the key; optional"
    },
    "sources": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "maxLength": 400,
      "not": { "pattern": "(?:^|[\\s\"'(=:])/[A-Za-z0-9._~-]+/" },
      "description": "a display string; a leading-slash path (/home/x/y) is refused so no absolute path reaches the page"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sid": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}$",
      "description": "a station id"
    },
    "status": { "enum": ["live", "building", "queued", "blocked"] },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "model", "does", "out"],
      "properties": {
        "id": { "$ref": "#/$defs/sid" },
        "role": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/text" },
        "does": { "$ref": "#/$defs/text" },
        "out": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "code"],
              "properties": {
                "kind": { "$ref": "#/$defs/text" },
                "code": { "type": "integer", "minimum": 100, "maximum": 599 }
              }
            }
          ],
          "description": "the record this station hands on, drawn on the belt after it; null for the last station"
        }
      }
    },
    "kickback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "tag"],
      "properties": {
        "from": { "$ref": "#/$defs/sid" },
        "to": { "$ref": "#/$defs/sid" },
        "tag": { "$ref": "#/$defs/text" },
        "esc": {
          "type": "boolean",
          "description": "an escalation lane (up to the architect, then the owner), drawn amber"
        }
      }
    },
    "part": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "enum": ["ok", "todo", "hand", "bad"] },
        { "$ref": "#/$defs/text" }
      ]
    },
    "stationstate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parts"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "parts": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/part" }
        },
        "hand": {
          "type": "boolean",
          "description": "the architect is doing this station's job by hand"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sub", "sim", "status", "belt", "here", "st"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]{2,16}$" },
        "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
        "name": { "$ref": "#/$defs/text" },
        "sub": { "$ref": "#/$defs/text" },
        "sim": {
          "type": "boolean",
          "description": "a line drawn to test the layout, never real state; a real collect emits false"
        },
        "status": { "$ref": "#/$defs/status" },
        "belt": { "enum": ["live", "stopped"] },
        "here": {
          "oneOf": [{ "$ref": "#/$defs/sid" }, { "type": "null" }],
          "description": "the station the work is at right now"
        },
        "waiting": {
          "$ref": "#/$defs/sid",
          "description": "the station whose record is sitting on a stopped belt"
        },
        "st": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/sid" },
          "additionalProperties": { "$ref": "#/$defs/stationstate" }
        }
      }
    },
    "glassline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "seat", "action", "state", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]{5}$", "description": "the short form of the request id" },
        "request": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9]{3}-[a-z0-9]{5}$", "description": "the break.glass 300 record id, which is also the owner card id" },
        "seat": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "state": { "enum": ["asked", "granted", "refused", "in effect", "done", "restored"] },
        "at": { "$ref": "#/$defs/utc", "description": "the latest record of the request" }
      }
    },
    "boardrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "t", "sub", "step"],
      "properties": {
        "k": { "$ref": "#/$defs/text" },
        "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
        "t": { "$ref": "#/$defs/text" },
        "sub": { "$ref": "#/$defs/text" },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 planned, 1 cut, 2 in progress, 3 PR, 4 merged"
        }
      }
    }
  }
}

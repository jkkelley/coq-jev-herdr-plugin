{
  "schema_version": "1.0.0",
  "project": "coq",
  "state_root": "${HOME}/.bearings",
  "listen_host": "127.0.0.1",
  "allowed_hosts": [
    "127.0.0.1",
    "localhost",
    "whoadudette-1.tailef6830.ts.net",
    "whoadudette-1",
    "100.122.200.108"
  ],
  "cookie_name": "bearings_key",
  "idle_minutes": 240,
  "settle_ms": 3000,
  "stop_tries": 3,
  "stop_try_ms": 5000,
  "max_body_bytes": 65536,
  "file_max_bytes": 26214400,
  "max_message_chars": 8000,
  "max_reply_chars": 32000,
  "max_words_chars": 4000,
  "messages_window": 50,
  "open_label_prefix": "OPEN - any tool",
  "pane_split": {
    "direction": "down",
    "ratio": 0.2
  },
  "tiers": {
    "stable": {
      "page": "${project}-stable",
      "port": 44900,
      "pane_label": "bearings-stable",
      "wait_pane_label": "bearings-stable-wait",
      "checkout": "main"
    },
    "uat": {
      "page": "${project}-uat-${ticket}",
      "port_range": [
        44910,
        44919
      ],
      "pane_label": "bearings-uat-${ticket}",
      "wait_pane_label": "bearings-uat-${ticket}-wait",
      "checkout": "treehouse slot on the PR branch"
    },
    "dev": {
      "page": "${project}-dev-${ticket}",
      "port_range": [
        44920,
        44939
      ],
      "pane_label": "bearings-dev-${ticket}",
      "wait_pane_label": "bearings-dev-${ticket}-wait",
      "checkout": "treehouse slot on the feature branch"
    }
  },
  "board_dir": "report/loop/out",
  "session_sync": {
    "interval_seconds": 5,
    "stale_minutes": 10,
    "watcher_grace_seconds": 5,
    "context_windows": {
      "claude-fable": 1000000
    }
  }
}

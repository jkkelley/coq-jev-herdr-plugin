<?xml version="1.0" encoding="UTF-8"?>
<!-- The contract every specs/scheduler/*.xml file validates against (specs/scheduler/bin/check.sh, xmllint in Podman).
     It is specs/schema/spec.xsd with one rule added: every element that carries words carries a source attribute that names
     where those words come from (a repo-relative file with an optional #locator, spec:SPEC-NN#anchor, node:PREFIX-slug, or
     owner:channel:UTC). A graph node cites through its source children instead. Elements an agent acts on carry an id.
     Why a second schema and not an edit of spec.xsd: spec.xsd is the locked contract of the SPEC-NN tree and a required
     attribute added there would fail every existing spec; this tree is the scheduler's and starts with the stricter rule. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="specId"><xs:restriction base="xs:string"><xs:pattern value="SPEC-16(\.[A-Z])?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="anySpecId"><xs:restriction base="xs:string"><xs:pattern value="SPEC-[0-9]{2}(\.[A-Z])?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="nodeId"><xs:restriction base="xs:string"><xs:pattern value="(DEC|REQ|CMP|IFC|SCH|WFL|NOD|ROL|SPK|RSK|STC|RUN)-[a-z0-9][a-z0-9-]{1,47}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="status"><xs:restriction base="xs:string"><xs:enumeration value="draft"/><xs:enumeration value="proposed"/><xs:enumeration value="locked"/><xs:enumeration value="superseded"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="edgeKind"><xs:restriction base="xs:string">
    <xs:enumeration value="depends_on"/><xs:enumeration value="implements"/><xs:enumeration value="decided_by"/><xs:enumeration value="verified_by"/><xs:enumeration value="risks"/><xs:enumeration value="owned_by"/><xs:enumeration value="defined_in"/><xs:enumeration value="supersedes"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="utc"><xs:restriction base="xs:string"><xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="level"><xs:restriction base="xs:string"><xs:enumeration value="MUST"/><xs:enumeration value="SHOULD"/><xs:enumeration value="NEVER"/></xs:restriction></xs:simpleType>
  <!-- source: a repo-relative path with an optional #locator, spec:SPEC-NN#anchor, node:PREFIX-slug, or owner:channel:UTC.
       check.sh resolves every path and every spec or node id; a source it cannot resolve fails the file. -->
  <xs:simpleType name="source"><xs:restriction base="xs:string"><xs:pattern value="([A-Za-z][A-Za-z0-9_./-]*(#[A-Za-z0-9_.,\[\]:/ -]+)?|spec:SPEC-[0-9]{2}(\.[A-Z])?(#[a-z0-9-]+)?|node:(DEC|REQ|CMP|IFC|SCH|WFL|NOD|ROL|SPK|RSK|STC|RUN)-[a-z0-9][a-z0-9-]{1,47}|owner:[a-z-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z)(;[ ]?([A-Za-z][A-Za-z0-9_./-]*(#[A-Za-z0-9_.,\[\]:/ -]+)?|spec:SPEC-[0-9]{2}(\.[A-Z])?(#[a-z0-9-]+)?|node:(DEC|REQ|CMP|IFC|SCH|WFL|NOD|ROL|SPK|RSK|STC|RUN)-[a-z0-9][a-z0-9-]{1,47}|owner:[a-z-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z))*"/></xs:restriction></xs:simpleType>

  <!-- text: one statement, under check.json under_chars, with the file it was read from. level marks a rule. -->
  <xs:complexType name="text"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="source" type="source" use="required"/>
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="level" type="level"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="mermaid"><xs:simpleContent><xs:extension base="xs:string"><xs:attribute name="source" type="source" use="required"/><xs:attribute name="id" type="xs:ID"/></xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="ref"><xs:attribute name="spec" type="anySpecId"/><xs:attribute name="node" type="nodeId"/><xs:attribute name="anchor" type="xs:string"/></xs:complexType>
  <xs:complexType name="example"><xs:sequence><xs:element name="text" type="xs:string"/><xs:element name="why" type="xs:string" minOccurs="0"/></xs:sequence>
    <xs:attribute name="kind" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="GOOD"/><xs:enumeration value="NEVER"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:complexType>
  <xs:complexType name="edge"><xs:attribute name="kind" type="edgeKind" use="required"/><xs:attribute name="to" type="nodeId" use="required"/></xs:complexType>
  <!-- node: a knowledge graph node this spec declares; graph.sh sync-specs needs the same title in graph/nodes/<id>.json. -->
  <xs:complexType name="node">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
      <xs:element name="source" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:attribute name="kind" use="required"/><xs:attribute name="id" use="required"/><xs:attribute name="at" type="utc"/></xs:complexType></xs:element>
      <xs:element name="edge" type="edge" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="example" type="example" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ref" type="ref" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="nodeId" use="required"/>
    <xs:attribute name="status" type="status" use="required"/>
  </xs:complexType>
  <!-- key: one configuration key. type is the JSON type; a key is required unless required="false". -->
  <xs:complexType name="key"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="required" type="xs:boolean"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- field: one field of a message, record or shared type. -->
  <xs:complexType name="field"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- verb: one executor verb; argv is the template, final is the exit codes that are a handled refusal, never retried. -->
  <xs:complexType name="verb"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="argv" type="xs:string" use="required"/>
    <xs:attribute name="timeout_seconds" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="final" type="xs:string"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- state: one state of a state machine; the words say what enters and leaves it. -->
  <xs:complexType name="state"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- case: one test case a build ticket's test plan carries; the words are its intent. -->
  <xs:complexType name="case"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="command" type="xs:string" use="required"/>
    <xs:attribute name="expected" type="xs:string" use="required"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- owns-route: this spec owns one row of the routes table; match is the row's match object as canonical JSON (keys sorted, no spaces).
       check.sh proves every row of the table is owned by exactly one spec. -->
  <xs:complexType name="owns-route"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="match" type="xs:string" use="required"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <!-- owns-code: this spec owns one status code; check.sh proves every code in check.json's universe is owned by exactly one spec. -->
  <xs:complexType name="owns-code"><xs:simpleContent><xs:extension base="xs:string">
    <xs:attribute name="value" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="source" type="source" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="section">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="text" type="text"/>
      <xs:element name="node" type="node"/>
      <xs:element name="example" type="example"/>
      <xs:element name="ref" type="ref"/>
      <xs:element name="mermaid" type="mermaid"/>
      <xs:element name="key" type="key"/>
      <xs:element name="field" type="field"/>
      <xs:element name="verb" type="verb"/>
      <xs:element name="state" type="state"/>
      <xs:element name="case" type="case"/>
      <xs:element name="owns-route" type="owns-route"/>
      <xs:element name="owns-code" type="owns-code"/>
      <xs:element name="section" type="section"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="title" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:element name="spec">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="contents"><xs:complexType><xs:sequence><xs:element name="item" maxOccurs="unbounded"><xs:complexType><xs:attribute name="ref" type="xs:IDREF" use="required"/><xs:attribute name="title" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
        <xs:element name="purpose" type="text"/>
        <xs:element name="section" type="section" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="specId" use="required"/>
      <xs:attribute name="domain" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[a-z][a-z-]{1,31}"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="version" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/></xs:restriction></xs:simpleType></xs:attribute>
      <xs:attribute name="title" use="required"/>
      <xs:attribute name="status" type="status" use="required"/>
      <xs:attribute name="updated" type="utc" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>

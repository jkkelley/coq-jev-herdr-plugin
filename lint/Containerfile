# Lint image for the repo: xmllint for the XML specs, jq, python3 jsonschema for configs,
# shellcheck for scripts. Pinned by digest (Rule 15). Human tag: debian:bookworm-slim.
FROM docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends libxml2-utils jq python3-jsonschema shellcheck >/dev/null && rm -rf /var/lib/apt/lists/*

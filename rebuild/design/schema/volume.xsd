<?xml version="1.0" encoding="UTF-8"?>
<!--
  rebuild/design/schema/volume.xsd
  The one XSD family every volume of the spec book validates against.
  Run: rebuild/design/check.sh (it finds a validator: python xmlschema, uv, or xmllint).

  What this schema fixes, and what it leaves to check.sh:
  - The envelope of every volume is strict: the root element is <volume> with id, kind, version and timezone="UTC",
    the first child is <contents> (entry refs), the second is <pointers> (a <parent> pointer plus siblings and shared pointers).
  - The body of a node volume is laxly assessed: seven author groups wrote seven vocabularies (named top-level elements
    in G1, G2, G5, G6, G7; <section id=...> in G3 and G4). A strict body type per group would be eight schemas pretending
    to be one, and every later volume kind (node-schema, node-runbook ...) would need another. The rules that matter
    (a many-agents section, every wait with a timeout and a fallback, every pointer resolving, 1000 lines) are
    structural and cross-file, so rebuild/design/bin/check-book.py checks them and prints one line per failure.
  - The shared vocabulary is strict: elements that only the shared volumes and the index use are declared globally
    (status-code, hard-rule, clause, store-table, store-rule, config-key, failure-case, rejection, node, book-version).
    Their names are chosen so no node volume uses them, because a lax wildcard validates any element that has a
    global declaration. Adding a global declaration here for a name a node volume already uses breaks that node.
  - The rejected alternative: XSD 1.1 xs:alternative on @kind would allow one root with per-kind bodies, but xmllint
    (the checker image) is XSD 1.0 only, and the checks that need cross-file knowledge still need a script.
  - Waits (added 2026-10-14, gap review R-03): a <wait> may carry class="bounded" (the default), "level-triggered" (the
    condition is re-read every tick, so nothing is held) or "owner-decision" (an owner card with its own escalation
    bound). A wait whose timeout is the word none must carry one of the last two; check-book.py C13 enforces it,
    because the body is lax here and a reviewer must be able to tell a deliberate unbounded wait from a missing bound.
  - record-kind (shared/record-kinds.xml, generated by bin/make-kinds.py) is declared globally below; no node volume
    uses the name.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">

  <!-- ===== simple types ===== -->
  <xs:simpleType name="volumeKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="node-spec"/>
      <xs:enumeration value="node-schema"/>
      <xs:enumeration value="node-checklist"/>
      <xs:enumeration value="node-permissions"/>
      <xs:enumeration value="node-monitoring"/>
      <xs:enumeration value="node-runbook"/>
      <xs:enumeration value="shared"/>
      <xs:enumeration value="index"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="nodeId">
    <xs:restriction base="xs:string"><xs:pattern value="N-[0-9]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="groupId">
    <xs:restriction base="xs:string"><xs:pattern value="G[1-9]"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="semver">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="utcDateOrDateTime">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="utcDateTime">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="anchorId">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9][A-Za-z0-9._:\-]*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="statusCode">
    <xs:restriction base="xs:integer"><xs:minInclusive value="100"/><xs:maxInclusive value="599"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="lamp">
    <xs:restriction base="xs:string">
      <xs:enumeration value="green"/><xs:enumeration value="amber"/><xs:enumeration value="red"/><xs:enumeration value="grey"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="actor">
    <xs:restriction base="xs:string">
      <xs:enumeration value="system"/><xs:enumeration value="owner"/><xs:enumeration value="seat"/><xs:enumeration value="nobody"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== pointer attributes: href, or path plus anchor (check.sh requires one of the two forms) ===== -->
  <xs:attributeGroup name="pointerAttrs">
    <xs:attribute name="href" type="xs:string"/>
    <xs:attribute name="path" type="xs:string"/>
    <xs:attribute name="anchor" type="xs:string"/>
    <xs:attribute name="node" type="xs:string"/>
    <xs:attribute name="kind" type="xs:string"/>
    <xs:attribute name="role" type="xs:string"/>
    <xs:attribute name="relation" type="xs:string"/>
    <xs:attribute name="row" type="xs:string"/>
    <xs:attribute name="note" type="xs:string"/>
    <xs:attribute name="why" type="xs:string"/>
  </xs:attributeGroup>
  <xs:complexType name="pointerType" mixed="true">
    <xs:sequence>
      <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="pointerAttrs"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- pointer elements only ever appear under <pointers>, so a global declaration is safe -->
  <xs:element name="parent" type="pointerType"/>
  <xs:element name="sibling" type="pointerType"/>
  <xs:element name="shared" type="pointerType"/>
  <xs:element name="dag" type="pointerType"/>

  <!-- ===== the envelope ===== -->
  <xs:complexType name="contentsType">
    <xs:sequence>
      <xs:element name="entry" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType mixed="true">
          <xs:sequence><xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
          <xs:attribute name="ref" type="xs:string" use="required"/>
          <xs:anyAttribute processContents="skip"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="pointersType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:element name="volume">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="contents" type="contentsType"/>
        <xs:element name="pointers" type="pointersType"/>
        <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="kind" type="volumeKind" use="required"/>
      <xs:attribute name="version" type="semver" use="required"/>
      <xs:attribute name="timezone" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="UTC"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="node" type="nodeId"/>
      <xs:attribute name="group" type="groupId"/>
      <xs:attribute name="issued" type="utcDateOrDateTime"/>
      <xs:attribute name="written" type="utcDateTime"/>
      <xs:attribute name="title" type="xs:string"/>
      <xs:attribute name="name" type="xs:string"/>
      <xs:attribute name="author" type="xs:string"/>
      <xs:anyAttribute namespace="http://www.w3.org/2001/XMLSchema-instance" processContents="skip"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== shared vocabulary (strict); names unused by any node volume ===== -->
  <xs:complexType name="proseType" mixed="true">
    <xs:sequence><xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- status-codes.xml: one element per code -->
  <xs:element name="status-code">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="meaning" type="proseType"/>
        <xs:element name="acts" type="proseType"/>
        <xs:element name="emitter" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="kinds" type="proseType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="value" type="statusCode" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="lamp" type="lamp" use="required"/>
      <xs:attribute name="actor" type="actor" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- principles.xml: one element per hard rule -->
  <xs:element name="hard-rule">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statement" type="proseType" maxOccurs="unbounded"/>
        <xs:element name="test" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="source" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="applies" type="proseType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="alias-of" type="anchorId"/>
    </xs:complexType>
  </xs:element>

  <!-- seat-contract.xml: one element per clause -->
  <xs:element name="clause">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rule" type="proseType" maxOccurs="unbounded"/>
        <xs:element name="check" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="source" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="applies" type="proseType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- state-store.xml: tables, rules, config keys -->
  <xs:element name="store-table">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="purpose" type="proseType"/>
        <xs:element name="column" maxOccurs="unbounded">
          <xs:complexType mixed="true">
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="key" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="rule" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="writer" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="reader" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="retention" type="proseType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="owner" type="xs:string" use="required"/>
      <xs:attribute name="mode" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="append-only"/><xs:enumeration value="cas"/><xs:enumeration value="upsert"/><xs:enumeration value="view"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="store-rule">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="statement" type="proseType" maxOccurs="unbounded"/>
        <xs:element name="example" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="source" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="config-key">
    <xs:complexType mixed="true">
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="default" type="xs:string" use="required"/>
      <xs:attribute name="unit" type="xs:string"/>
      <xs:attribute name="owner" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- failure-cases.xml -->
  <xs:element name="failure-case">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="symptom" type="proseType"/>
        <xs:element name="detected-by" type="proseType"/>
        <xs:element name="response" type="proseType" maxOccurs="unbounded"/>
        <xs:element name="records" type="proseType"/>
        <xs:element name="owner-sees" type="proseType"/>
        <xs:element name="never" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="source" type="proseType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="nodes" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- rejected-with-reason.xml -->
  <xs:element name="rejection">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="reason" type="proseType"/>
        <xs:element name="harvested" type="proseType" minOccurs="0"/>
        <xs:element name="superseded-by" type="proseType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="source" type="xs:string" use="required"/>
      <xs:attribute name="branch" type="xs:string"/>
      <xs:attribute name="status" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="source-only"/><xs:enumeration value="rejected"/><xs:enumeration value="retired"/><xs:enumeration value="fix-ticket"/><xs:enumeration value="later"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- record-kinds.xml (generated by bin/make-kinds.py) -->
  <xs:element name="record-kind">
    <xs:complexType>
      <xs:attribute name="name" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[a-z][a-z0-9_\-]*(\.[a-z0-9_\-]+)*"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="codes" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[1-5][0-9]{2}( [1-5][0-9]{2})*"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="writers" use="required">
        <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="N-[0-9]{2}( N-[0-9]{2})*"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="class" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="record"/><xs:enumeration value="line-op"/><xs:enumeration value="owner-surface"/><xs:enumeration value="plan"/><xs:enumeration value="screen"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="status-names" type="xs:string"/>
      <xs:attribute name="storage">
        <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="entity-only"/></xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="coalesce-key" type="xs:string"/>
      <xs:attribute name="schema" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- index.xml -->
  <xs:element name="node">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="input" type="proseType"/>
        <xs:element name="output" type="proseType"/>
        <xs:element name="volume-ref" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="href" type="xs:string" use="required"/>
            <xs:attribute name="kind" type="xs:string" use="required"/>
            <xs:attribute name="lines" type="xs:nonNegativeInteger"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" type="nodeId" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="group" type="groupId" use="required"/>
      <xs:attribute name="status" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="pending"/><xs:enumeration value="specified"/><xs:enumeration value="reviewed"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="edition">
    <xs:complexType mixed="true">
      <xs:attribute name="id" type="anchorId" use="required"/>
      <xs:attribute name="value" type="semver" use="required"/>
      <xs:attribute name="bumped" type="utcDateTime" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>

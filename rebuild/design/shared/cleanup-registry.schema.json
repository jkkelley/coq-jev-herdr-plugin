{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jkkelley/coq-jev-herdr-plugin/rebuild/design/shared/cleanup-registry.schema.json",
  "title": "Cleanup registry (generated by rebuild/design/bin/registry.py)",
  "description": "Every state path a node volume names, with the command that cleans it. N-45 runs line/bin/cleanup.sh --entry <id>, which looks the entry up here and runs its run command in plan, then apply, mode. Retention never with acts owner means kept on purpose: cleanup.sh lists the path and refuses apply; only the owner removes it, by break glass or disposition.",
  "type": "object",
  "required": ["generated_by", "schema", "rule", "entries"],
  "additionalProperties": false,
  "properties": {
    "generated_by": { "const": "rebuild/design/bin/registry.py" },
    "schema": { "const": "shared/cleanup-registry.schema.json" },
    "rule": { "type": "string" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "node",
        "glob",
        "class",
        "retention",
        "trigger",
        "acts",
        "run",
        "verb",
        "holds",
        "note",
        "volume"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^N-[0-9]{2}\\.[a-z0-9.-]+$" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "glob": { "type": "string", "minLength": 1 },
        "class": { "enum": ["host", "store", "client", "external", "tracked"] },
        "retention": {
          "type": "string",
          "minLength": 1,
          "description": "An ISO 8601 duration, never, or the volume's words for a rule the run command applies"
        },
        "trigger": { "type": "string" },
        "acts": { "enum": ["system", "owner"] },
        "run": {
          "type": "string",
          "minLength": 1,
          "description": "The cleanup command as the node volume names it"
        },
        "verb": {
          "type": "string",
          "pattern": "^line/bin/cleanup\\.sh --entry N-[0-9]{2}\\.[a-z0-9.-]+$"
        },
        "holds": { "type": "string" },
        "note": { "type": "string" },
        "volume": {
          "type": "string",
          "pattern": "^nodes/N-[0-9]{2}/[a-z0-9.-]+\\.xml$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-18/record.schema.json",
  "title": "N-18 Validator: input and output records",
  "description": "Input: ticket-set.draft (../N-17/record.schema.json#/$defs/ticket-set.draft). Outputs: ticket (accepted, one per drafted ticket), ticket-set.accepted, validator.refused, validator.failed.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ticket_id": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "idempotency_key"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "kind": { "type": "string" },
        "code": { "type": "integer", "enum": [100, 200, 201, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-18" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "idempotency_key": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "ticket-set.draft": { "$ref": "../N-17/record.schema.json#/$defs/ticket-set.draft" },
    "observed_acceptance": {
      "allOf": [{ "$ref": "../N-17/record.schema.json#/$defs/acceptance" }],
      "type": "object",
      "required": ["observed_exit_on_main", "observed_at", "observed_at_sha", "duration_seconds", "log_path"],
      "properties": {
        "observed_exit_on_main": { "type": "integer", "minimum": 0, "maximum": 255 },
        "observed_at": { "$ref": "#/$defs/utc" },
        "observed_at_sha": { "$ref": "#/$defs/sha1" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "log_path": { "type": "string" },
        "stdout_tail": { "type": "string", "maxLength": 2000 },
        "stderr_tail": { "type": "string", "maxLength": 2000 }
      }
    },
    "ticket": {
      "allOf": [{ "$ref": "#/$defs/envelope" }, { "$ref": "../N-17/record.schema.json#/$defs/draft_ticket" }],
      "type": "object",
      "required": ["ticket", "set_id", "status", "acceptance", "depends_on_ids", "cut_at"],
      "properties": {
        "kind": { "const": "ticket" },
        "code": { "const": 201 },
        "idempotency_key": { "type": "string", "pattern": "^[^:]+:t[0-9]{1,3}$", "description": "set_id:key" },
        "ticket": { "$ref": "#/$defs/ticket_id" },
        "set_id": { "type": "string" },
        "status": { "const": "cut", "description": "N-03 moves it to waiting, ready; later nodes to started, pr-open, merged, verified, dead, cancelled" },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observed_acceptance" } },
        "depends_on_ids": { "type": "array", "items": { "$ref": "#/$defs/ticket_id" } },
        "cut_at": { "$ref": "#/$defs/utc" },
        "validate_log": { "type": "string" }
      }
    },
    "ticket-set.accepted": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["set_id", "anchor", "tickets", "observed_at_sha", "validate_seconds"],
      "properties": {
        "kind": { "const": "ticket-set.accepted" },
        "code": { "const": 201 },
        "idempotency_key": { "type": "string", "description": "equals set_id" },
        "set_id": { "type": "string" },
        "anchor": { "type": "string" },
        "tickets": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "ticket", "title"], "properties": { "key": { "type": "string" }, "ticket": { "$ref": "#/$defs/ticket_id" }, "title": { "type": "string" } } } },
        "observed_at_sha": { "$ref": "#/$defs/sha1" },
        "validate_seconds": { "type": "number", "minimum": 0 },
        "validate_log": { "type": "string" }
      }
    },
    "validator.refused": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["set_id", "check", "detail"],
      "properties": {
        "kind": { "const": "validator.refused" },
        "code": { "enum": [400, 422] },
        "idempotency_key": { "type": "string", "description": "equals set_id" },
        "set_id": { "type": "string" },
        "anchor": { "type": "string" },
        "check": { "enum": ["schema", "anchor_moved", "files", "records", "depends", "size", "duplicate", "acceptance", "validator_timeout"] },
        "ticket_key": { "type": "string", "pattern": "^t[0-9]{1,3}$" },
        "acceptance_id": { "type": "string" },
        "reason": { "enum": ["cannot_run", "already_passing", "runs_in_pod_unknown", "aggregate", "runtime_path", "overlap", "too_many_files", "unknown_path", "unknown_kind", "unresolved", "cycle", "go_live_without_build", "too_large", "duplicate_of", "timeout", "schema_invalid", "moved"] },
        "command": { "type": "string" },
        "observed_exit": { "type": "integer" },
        "expect_exit": { "type": "integer" },
        "stderr_tail": { "type": "string", "maxLength": 2000 },
        "detail": { "type": "string", "maxLength": 2000 },
        "existing_ticket": { "$ref": "#/$defs/ticket_id" },
        "log_path": { "type": "string" }
      }
    },
    "validator.failed": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["set_id", "reason", "attempts"],
      "properties": {
        "kind": { "const": "validator.failed" },
        "code": { "const": 500 },
        "set_id": { "type": "string" },
        "reason": { "enum": ["store_unreachable", "workspace", "podman", "image"] },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "stderr_tail": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/ticket-set.draft" },
    { "$ref": "#/$defs/ticket" },
    { "$ref": "#/$defs/ticket-set.accepted" },
    { "$ref": "#/$defs/validator.refused" },
    { "$ref": "#/$defs/validator.failed" }
  ]
}

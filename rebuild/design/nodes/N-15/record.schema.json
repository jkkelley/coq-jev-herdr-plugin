{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-15/record.schema.json",
  "title": "N-15 One-shot seat launcher: input and output records",
  "description": "Inputs: seat.bundle (../N-13/record.schema.json#/$defs/seat.bundle) and workspace (../N-14/record.schema.json#/$defs/workspace). Outputs: seat.heartbeat, seat.result, phase.failed, launcher.defect. Also defines the claude -p result envelope the launcher parses (harness_result).",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "idempotency_key"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "kind": { "type": "string" },
        "code": { "type": "integer", "enum": [100, 200, 201, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-15" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "idempotency_key": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "seat.bundle": { "$ref": "../N-13/record.schema.json#/$defs/seat.bundle" },
    "workspace": { "$ref": "../N-14/record.schema.json#/$defs/workspace" },
    "terminal_reason": {
      "enum": [
        "success", "error_max_turns", "error_max_budget_usd", "error_during_execution", "error_max_structured_output_retries",
        "killed_deadline", "killed_stall", "killed_lease_lost", "killed_by_record", "crashed", "no_result", "schema_invalid",
        "bundle_mismatch", "workspace_mismatch", "lease_expired", "output_rejected", "seat_blocked"
      ]
    },
    "harness_result": {
      "type": "object",
      "description": "The claude -p --output-format json envelope as parsed; fields beyond these are kept verbatim in result.json",
      "required": ["type", "subtype", "is_error", "session_id"],
      "properties": {
        "type": { "const": "result" },
        "subtype": { "enum": ["success", "error_max_turns", "error_max_budget_usd", "error_during_execution", "error_max_structured_output_retries"] },
        "is_error": { "type": "boolean" },
        "session_id": { "type": "string" },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "num_turns": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "structured_output": {},
        "permission_denials": { "type": "array", "items": { "type": "object" } },
        "api_error_status": { "type": "integer" },
        "usage": { "type": "object" }
      }
    },
    "seat.heartbeat": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["run_id", "pid", "started_at", "progress_at", "seq", "lease"],
      "properties": {
        "kind": { "const": "seat.heartbeat" },
        "code": { "const": 100 },
        "run_id": { "type": "string" },
        "ticket": { "type": "string" },
        "pid": { "type": "integer", "minimum": 1 },
        "started_at": { "$ref": "#/$defs/utc" },
        "progress_at": { "$ref": "#/$defs/utc", "description": "mtime of the session transcript" },
        "seq": { "type": "integer", "minimum": 1, "description": "monotonic per run; the store keeps the highest" },
        "transcript_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "turns_so_far": { "type": "integer", "minimum": 0 },
        "lease": { "$ref": "../N-13/record.schema.json#/$defs/lease" },
        "renewed": { "type": "boolean", "description": "the lease service accepted this beat's renewal" },
        "adopted": { "type": "boolean", "description": "true when the beat comes from a launcher that adopted the run after a restart (spec.xml#adopt); the bound is deadline_at from started.json either way" }
      }
    },
    "seat.result": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["run_id", "role", "phase", "attempt", "outcome", "terminal_reason", "session_id", "model", "started_at", "finished_at", "duration_seconds", "result_path", "stderr_path"],
      "properties": {
        "kind": { "const": "seat.result" },
        "code": { "enum": [200, 412, 423] },
        "run_id": { "type": "string" },
        "ticket": { "type": "string" },
        "role": { "enum": ["worker", "spec-author", "reviewer"] },
        "phase": { "enum": ["worker", "spec-author", "reviewer"] },
        "outcome": { "enum": ["done", "blocked"] },
        "terminal_reason": { "$ref": "#/$defs/terminal_reason" },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "cost_usd": { "type": "number", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "session_id": { "type": "string" },
        "model": { "type": "string" },
        "started_at": { "$ref": "#/$defs/utc" },
        "finished_at": { "$ref": "#/$defs/utc" },
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "permission_denials": {
          "type": "object",
          "properties": { "count": { "type": "integer" }, "first": { "type": "array", "maxItems": 5, "items": { "type": "object" } } }
        },
        "api_error_status": { "type": "integer" },
        "adopted": { "type": "boolean", "description": "true when the run was adopted after a launcher restart; exit_code is then null because a non-child cannot be waited on" },
        "structured": { "description": "the phase's validated structured output; present only when outcome is done" },
        "blocked": {
          "type": "object",
          "description": "present when the seat declared itself blocked or the post step rejected the output",
          "properties": {
            "reason": { "type": "string" },
            "observations": { "type": "array", "items": { "type": "object", "required": ["path", "saw", "expected"], "properties": { "path": { "type": "string" }, "line": { "type": "integer" }, "saw": { "type": "string" }, "expected": { "type": "string" } } } },
            "repro": { "type": "string" }
          }
        },
        "result_path": { "type": "string" },
        "stderr_path": { "type": "string" },
        "transcript_path": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "code": { "const": 200 } }, "required": ["structured"] } },
        { "if": { "properties": { "outcome": { "const": "blocked" } } }, "then": { "properties": { "code": { "enum": [412, 423] } } } }
      ]
    },
    "phase.failed": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["run_id", "phase", "step", "reason", "attempts"],
      "properties": {
        "kind": { "const": "phase.failed" },
        "code": { "const": 500 },
        "run_id": { "type": "string" },
        "phase": { "enum": ["worker", "spec-author", "reviewer"] },
        "step": { "type": "string" },
        "reason": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "stderr_tail": { "type": "string", "maxLength": 2000 }
      }
    },
    "launcher.defect": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "type": "object",
      "required": ["run_id", "reason"],
      "properties": {
        "kind": { "const": "launcher.defect" },
        "code": { "const": 500 },
        "run_id": { "type": "string" },
        "reason": { "enum": ["survivor_after_sigkill", "result_put_never_landed", "two_launchers_disagree"] },
        "detail": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/seat.bundle" },
    { "$ref": "#/$defs/workspace" },
    { "$ref": "#/$defs/seat.heartbeat" },
    { "$ref": "#/$defs/seat.result" },
    { "$ref": "#/$defs/phase.failed" },
    { "$ref": "#/$defs/launcher.defect" }
  ]
}

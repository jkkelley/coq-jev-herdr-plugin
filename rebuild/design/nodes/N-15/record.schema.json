{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-15/record.schema.json",
  "title": "N-15 One-shot seat launcher: input and output records",
  "description": "Book 1.1.0. Inputs: seat.bundle (../N-13/record.schema.json#/$defs/seat.bundle), workspace (../N-14/record.schema.json#/$defs/workspace) and the dispatch they name (../N-07/record.schema.json#/$defs/dispatch). Outputs: seat.result and phase.failed records (shared committed envelope; a blocked seat.result and phase.failed carry ../../shared/contracts.schema.json#/$defs/failure_body), launcher.defect, the heartbeats row of a run (seat.heartbeat, entity-only, shared/contracts.xml#entity-only) and the run:<run_id> state entity (run_state, shared/contracts.xml#run-states). Also defines the claude -p result envelope the launcher parses (harness_result). The operation key N-15/seat.result/<run_id>/r1 rides on the Commit request.",
  "$defs": {
    "at": {
      "$ref": "../../shared/contracts.schema.json#/$defs/at"
    },
    "envelope": {
      "$ref": "../../shared/state-store.schema.json#/$defs/committed_envelope"
    },
    "run_id": {
      "$ref": "../N-13/record.schema.json#/$defs/run_id"
    },
    "seat.bundle": {
      "$ref": "../N-13/record.schema.json#/$defs/seat.bundle"
    },
    "workspace": {
      "$ref": "../N-14/record.schema.json#/$defs/workspace"
    },
    "dispatch": {
      "$ref": "../N-07/record.schema.json#/$defs/dispatch"
    },
    "terminal_reason": {
      "enum": [
        "success",
        "error_max_turns",
        "error_max_budget_usd",
        "error_during_execution",
        "error_max_structured_output_retries",
        "killed_deadline",
        "killed_by_record",
        "killed_lease_lost",
        "crashed",
        "failed_spawn",
        "no_result",
        "schema_invalid",
        "bundle_mismatch",
        "workspace_mismatch",
        "claim_missing",
        "lease_not_current",
        "harness_mismatch",
        "output_rejected",
        "seat_blocked"
      ]
    },
    "harness_result": {
      "type": "object",
      "description": "The claude -p --output-format json envelope as parsed from result.json; fields beyond these are kept verbatim in result.json",
      "required": [
        "type",
        "subtype",
        "is_error",
        "session_id"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "subtype": {
          "enum": [
            "success",
            "error_max_turns",
            "error_max_budget_usd",
            "error_during_execution",
            "error_max_structured_output_retries"
          ]
        },
        "is_error": {
          "type": "boolean"
        },
        "session_id": {
          "type": "string"
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "num_turns": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "structured_output": {},
        "permission_denials": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "api_error_status": {
          "type": "integer"
        },
        "usage": {
          "type": "object"
        }
      }
    },
    "run_state": {
      "description": "The run:<run_id> entity, the launcher's only recovery input: every step is a compare-and-swap from the previous state, so a restarted launcher iterates entities, never directories (shared/contracts.xml#run-states).",
      "type": "object",
      "required": [
        "entity",
        "run_id",
        "state",
        "unit",
        "dispatch_id",
        "lease",
        "deadline_at",
        "version"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "pattern": "^run:d-[0-9]{14}-[a-z0-9]{6}$"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "state": {
          "enum": [
            "spawning",
            "running",
            "exited",
            "result_committed",
            "closed_out",
            "failed_spawn"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^coq-seat-d-[0-9]{14}-[a-z0-9]{6}\\.service$",
          "description": "the transient unit systemd-run created; adoption is by this name"
        },
        "seat_user": {
          "type": "string",
          "pattern": "^coq-seat-[0-9]{2}$"
        },
        "dispatch_id": {
          "$ref": "#/$defs/run_id"
        },
        "lease": {
          "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref"
        },
        "deadline_at": {
          "$ref": "#/$defs/at"
        },
        "started_at": {
          "$ref": "#/$defs/at"
        },
        "exited_at": {
          "$ref": "#/$defs/at"
        },
        "result_sha256": {
          "$ref": "../../shared/state-store.schema.json#/$defs/sha256",
          "description": "sha256 of result.json as written in result.ok"
        },
        "seat_result_ref": {
          "type": "string"
        },
        "phase_record_ref": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "seat.heartbeat": {
      "description": "The heartbeats row of one run (table heartbeats, owner N-15, statement heartbeats.upsert keyed by run_id), written with Lease.Renew in the N-15/lease.renew Commit every lease.heartbeat_seconds (shared/contracts.xml#timing). Entity-only (shared/contracts.xml#entity-only): no record is appended unless adopted turns true or the token changes. N-12 reads it.",
      "type": "object",
      "required": [
        "run_id",
        "unit",
        "started_at",
        "progress_at",
        "beat",
        "lease",
        "renewed"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "ticket": {
          "$ref": "../../shared/contracts.schema.json#/$defs/ticket"
        },
        "unit": {
          "type": "string",
          "pattern": "^coq-seat-d-[0-9]{14}-[a-z0-9]{6}\\.service$"
        },
        "main_pid": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "$ref": "#/$defs/at"
        },
        "progress_at": {
          "$ref": "#/$defs/at",
          "description": "mtime of the session transcript"
        },
        "beat": {
          "type": "integer",
          "minimum": 1,
          "description": "monotonic per run; the subject of the N-15/lease.renew operation key"
        },
        "transcript_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "turns_so_far": {
          "type": "integer",
          "minimum": 0
        },
        "lease": {
          "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref",
          "description": "the integer token the renewal carried"
        },
        "renewed": {
          "type": "boolean",
          "description": "Lease.Renew accepted this beat"
        },
        "adopted": {
          "type": "boolean",
          "description": "true when the beat comes from a launcher that adopted the unit after a restart"
        }
      }
    },
    "denied_line_ops": {
      "type": "object",
      "required": [
        "count",
        "commands"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "the first five denied commands that are line operations (git push, gh, a store or herdr call); N-51 sums count"
        }
      },
      "additionalProperties": false
    },
    "seat.result": {
      "type": "object",
      "required": [
        "run_id",
        "ticket",
        "role",
        "phase",
        "attempt",
        "lease",
        "outcome",
        "terminal_reason",
        "session_id",
        "model",
        "harness",
        "started_at",
        "finished_at",
        "duration_seconds",
        "denied_line_ops",
        "result_path",
        "stderr_path"
      ],
      "properties": {
        "kind": {
          "const": "seat.result"
        },
        "code": {
          "enum": [
            200,
            412,
            423
          ]
        },
        "node": {
          "const": "N-15"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "dispatch_id": {
          "$ref": "#/$defs/run_id",
          "description": "optional: equals run_id (shared/contracts.xml#dispatch)"
        },
        "ticket": {
          "$ref": "../../shared/contracts.schema.json#/$defs/ticket"
        },
        "role": {
          "$ref": "../N-13/record.schema.json#/$defs/seat_role"
        },
        "phase": {
          "$ref": "../N-13/record.schema.json#/$defs/seat_phase"
        },
        "attempt": {
          "$ref": "../../shared/contracts.schema.json#/$defs/attempt"
        },
        "lease": {
          "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref"
        },
        "fenced": {
          "type": "boolean",
          "description": "stamped true when the store accepted this result under the terminal-report exception (shared/contracts.xml#terminal-report); N-11 treats it as an echo"
        },
        "outcome": {
          "enum": [
            "done",
            "blocked"
          ]
        },
        "terminal_reason": {
          "$ref": "#/$defs/terminal_reason"
        },
        "failure_kind": {
          "$ref": "../../shared/contracts.schema.json#/$defs/failure_kind"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "harness": {
          "type": "object",
          "required": [
            "version",
            "sha256"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "sha256": {
              "$ref": "../../shared/state-store.schema.json#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "started_at": {
          "$ref": "#/$defs/at"
        },
        "finished_at": {
          "$ref": "#/$defs/at"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "permission_denials": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer"
            },
            "first": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object"
              }
            }
          }
        },
        "denied_line_ops": {
          "$ref": "#/$defs/denied_line_ops"
        },
        "api_error_status": {
          "type": "integer"
        },
        "adopted": {
          "type": "boolean"
        },
        "structured": {
          "description": "the phase's validated structured output; present only when outcome is done"
        },
        "phase_record_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "null in the seat.result; the post step's phase record id lives on the run:<run_id> entity (records are append-only)"
        },
        "blocked": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "saw",
                  "expected"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "saw": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string"
                  }
                }
              }
            },
            "repro": {
              "type": "string"
            }
          }
        },
        "result_path": {
          "type": "string"
        },
        "result_sha256": {
          "$ref": "../../shared/state-store.schema.json#/$defs/sha256"
        },
        "stderr_path": {
          "type": "string"
        },
        "transcript_path": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "done"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": 200
              },
              "terminal_reason": {
                "const": "success"
              }
            },
            "required": [
              "structured",
              "cost_usd",
              "turns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  412,
                  423
                ]
              }
            },
            "allOf": [
              {
                "$ref": "../../shared/contracts.schema.json#/$defs/failure_body"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "terminal_reason": {
                "enum": [
                  "bundle_mismatch",
                  "workspace_mismatch",
                  "claim_missing",
                  "lease_not_current",
                  "harness_mismatch"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": 412
              }
            }
          }
        }
      ]
    },
    "phase.failed": {
      "description": "The shared shape of the close-out failure the phase owners write (N-16 worker, N-17 spec-author, N-19 reviewer) after three recovery passes (shared/contracts.xml#retry-owner row phase.failed): a charged failure for N-11 with a fresh session.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "$ref": "../../shared/contracts.schema.json#/$defs/failure_body"
        },
        {
          "if": {
            "properties": {
              "step": {
                "enum": [
                  "diff_check",
                  "head.check"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "const": "output_rejected"
              }
            }
          },
          "else": {
            "properties": {
              "failure_kind": {
                "const": "phase.failed"
              },
              "passes": {
                "const": 3
              }
            }
          }
        }
      ],
      "required": [
        "run_id",
        "phase",
        "step",
        "reason",
        "passes",
        "lease"
      ],
      "properties": {
        "kind": {
          "const": "phase.failed"
        },
        "code": {
          "const": 500
        },
        "node": {
          "enum": [
            "N-16",
            "N-17",
            "N-19"
          ],
          "description": "written by the close-out owner of the phase after its own three tries (shared/contracts.xml#retry-owner); the launcher never writes it"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "dispatch_id": {
          "$ref": "#/$defs/run_id"
        },
        "phase": {
          "$ref": "../N-13/record.schema.json#/$defs/seat_phase"
        },
        "lease": {
          "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref"
        },
        "outcome": {
          "const": "failed"
        },
        "failure_kind": {
          "enum": [
            "phase.failed",
            "output_rejected"
          ]
        },
        "step": {
          "enum": [
            "diff_check",
            "branch.push",
            "pr.open",
            "pr.verify",
            "draft.put",
            "head.check",
            "verdict.put",
            "review.mirror"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "passes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "stderr_tail": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "launcher.defect": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "required": [
        "run_id",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "launcher.defect"
        },
        "code": {
          "const": 500
        },
        "node": {
          "const": "N-15"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "reason": {
          "enum": [
            "unit_survived_stop",
            "result_put_never_landed",
            "two_launchers_disagree",
            "result_ok_mismatch"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/seat.bundle"
    },
    {
      "$ref": "#/$defs/workspace"
    },
    {
      "$ref": "#/$defs/seat.heartbeat"
    },
    {
      "$ref": "#/$defs/run_state"
    },
    {
      "$ref": "#/$defs/seat.result"
    },
    {
      "$ref": "#/$defs/phase.failed"
    },
    {
      "$ref": "#/$defs/launcher.defect"
    }
  ]
}

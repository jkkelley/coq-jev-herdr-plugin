{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-25/record.schema.json",
  "title": "N-25 Gate status post: input result set for one head sha and output gate.run (the coq/gate status as posted)",
  "description": "Written 2026-10-14T04:39Z UTC by the G4 spec-author seat. Envelope repeated from N-20 until shared/state-store.schema.json lands.",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/protection" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "attempt", "key", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^r-[0-9]{17}-[a-z0-9]{5}$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "code": { "type": "integer", "enum": [100, 200, 201, 300, 400, 409, 410, 412, 422, 423, 429, 500, 503] },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "key": { "type": "string", "minLength": 3 },
        "version": { "type": "integer", "minimum": 1 },
        "lease_token": { "type": "string" },
        "note": { "type": "string", "maxLength": 240 }
      }
    },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "input": {
      "type": "object",
      "title": "The result set the verdict rule reads; assembled from pod.run and check.verdict records, not stored as one row",
      "required": ["head_sha", "pr", "plan_attempt", "plan_kind", "entries_total", "results", "bound_passed"],
      "properties": {
        "head_sha": { "$ref": "#/$defs/sha40" },
        "pr": { "type": "integer", "minimum": 0 },
        "plan_attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "plan_kind": { "type": "string", "enum": ["pr", "main"] },
        "entries_total": { "type": "integer", "minimum": 0 },
        "bound_passed": { "type": "boolean" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "code", "outcome"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string", "enum": ["pod", "spec-check"] },
              "record": { "type": "string", "description": "pod.run or check.verdict record id" },
              "code": { "type": "integer", "enum": [201, 422, 500, 410] },
              "outcome": { "type": "string", "enum": ["pass", "fail", "timeout", "infra", "superseded"] },
              "log": { "type": "string" }
            }
          }
        }
      }
    },
    "output": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["head_sha", "pr", "plan_attempt", "plan_kind", "state", "description", "target_url", "counts", "posted"],
          "properties": {
            "kind": { "enum": ["gate.run", "gate.pending"] },
            "code": { "enum": [100, 201, 422, 500, 410, 412] },
            "node": { "const": "N-25" },
            "head_sha": { "$ref": "#/$defs/sha40" },
            "pr": { "type": "integer", "minimum": 0 },
            "plan_attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
            "plan_kind": { "type": "string", "enum": ["pr", "main"] },
            "context": { "const": "coq/gate" },
            "state": { "type": "string", "enum": ["pending", "success", "failure", "error"] },
            "description": { "type": "string", "minLength": 1, "maxLength": 140 },
            "target_url": { "type": "string", "format": "uri" },
            "counts": {
              "type": "object",
              "required": ["pass", "fail", "timeout", "infra", "superseded", "spec_check_pass", "spec_check_fail"],
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "integer", "minimum": 0 }, "fail": { "type": "integer", "minimum": 0 },
                "timeout": { "type": "integer", "minimum": 0 }, "infra": { "type": "integer", "minimum": 0 },
                "superseded": { "type": "integer", "minimum": 0 },
                "spec_check_pass": { "type": "integer", "minimum": 0 }, "spec_check_fail": { "type": "integer", "minimum": 0 }
              }
            },
            "first_failure": { "type": "object", "properties": { "name": { "type": "string" }, "log": { "type": "string" } } },
            "superseded_by": { "$ref": "#/$defs/sha40" },
            "posted": {
              "type": "object", "required": ["ok", "attempts"],
              "properties": {
                "ok": { "type": "boolean" },
                "status_id": { "type": "integer" },
                "created_at": { "$ref": "#/$defs/utc" },
                "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
                "skipped_same_content": { "type": "boolean" }
              }
            }
          },
          "allOf": [
            { "if": { "properties": { "state": { "const": "success" } } }, "then": { "properties": { "code": { "const": 201 } } } },
            { "if": { "properties": { "state": { "const": "failure" } } }, "then": { "properties": { "code": { "const": 422 } }, "required": ["first_failure"] } },
            { "if": { "properties": { "state": { "const": "pending" } } }, "then": { "properties": { "code": { "const": 100 }, "kind": { "const": "gate.pending" } } } },
            { "if": { "properties": { "code": { "const": 410 } } }, "then": { "properties": { "state": { "const": "error" } }, "required": ["superseded_by"] } }
          ]
        }
      ]
    },
    "protection": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["branch", "contexts", "strict"],
          "properties": {
            "kind": { "enum": ["protection.applied", "protection.failed", "status.post.failed"] },
            "code": { "enum": [200, 500] },
            "node": { "const": "N-25" },
            "branch": { "const": "main" },
            "contexts": { "type": "array", "contains": { "const": "coq/gate" } },
            "strict": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      ]
    }
  }
}

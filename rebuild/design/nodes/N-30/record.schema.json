{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-30/record.schema.json",
  "title": "N-30 Go inbox with acks: input and output records",
  "description": "owner.message (input), routed.message, ack and reply (outputs) with the refusal forms. Envelope per shared/state-store.xml#envelope.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "messageId": { "$ref": "../../shared/state-store.schema.json#/$defs/id" },
    "recordId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "tier": { "enum": ["stable", "uat", "dev"] },
    "lane": { "enum": ["control", "ticket", "card", "sitrep", "architect", "system", "unroutable"] },
    "ackState": {
      "enum": ["accepted", "routed", "consumed", "deferred", "answered", "stale"],
      "description": "deferred: a templated holding line was sent at the sla and a reply is still owed; it is never answered"
    },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "not": {"pattern": "[?&]key="} },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string" },
        "code": { "enum": [100, 200, 201, 204, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-30" },
        "seq": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "maxLength": 128 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "owner.message": {
      "title": "owner.message (input)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "owner.message" },
        "code": { "const": 100 },
        "id": { "$ref": "#/$defs/messageId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "files": { "type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^f-[0-9]{17}-[a-z0-9]{5}$"} },
        "reply_to": { "type": "string", "pattern": "^([0-9]{8}T[0-9]{6}Z-[0-9]{3}-[a-z0-9]{5}|C-[0-9]{1,6})$" },
        "tier": { "$ref": "#/$defs/tier" },
        "principal_role": { "enum": ["owner", "viewer"], "description": "the page session's role (nodes/N-32/spec.xml#web-security); only owner can carry an owner word" },
        "imported": { "type": "boolean", "description": "legacy cut-over import: never routed, ack answered reason imported" },
        "legacy_id": { "type": "string", "pattern": "^m-[0-9]{17}-[a-z0-9]{5}$", "description": "imported messages only: the old page's id" }
      },
      "required": ["text", "tier", "principal_role"],
      "dependentRequired": { "legacy_id": ["imported"] }
    },
    "routed.message": {
      "title": "routed.message (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "routed.message" },
        "code": { "const": 300 },
        "message": { "$ref": "#/$defs/messageId" },
        "lane": { "$ref": "#/$defs/lane" },
        "consumer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "N-29, N-03, N-06, internal/owner/sitrep or architect-digest"
        },
        "rule": { "type": "string", "pattern": "^R[0-9]{2}$" },
        "sla_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "transform": {
          "type": "object",
          "description": "the derived record the consumer receives (owner.answer, ticket.request) by id",
          "properties": { "kind": {"type": "string"}, "id": {"$ref": "#/$defs/recordId"} }
        },
        "idempotency_key": { "type": "string", "pattern": "^N-30/route/", "description": "N-30/route/<message id>/r1 (shared/contracts.xml#operation-keys)" }
      },
      "required": ["message", "lane", "consumer", "rule", "sla_seconds", "idempotency_key"]
    },
    "ack": {
      "title": "ack (output, upsert keyed ack:<message>, state only moves forward)",
      "properties": {
        "kind": { "const": "ack" },
        "code": { "enum": [100, 200, 500] },
        "message": { "$ref": "#/$defs/messageId" },
        "state": { "$ref": "#/$defs/ackState" },
        "by": { "type": "string", "maxLength": 64 },
        "ref": { "$ref": "#/$defs/recordId" },
        "elapsed_seconds": { "type": "integer", "minimum": 0, "description": "stale only" },
        "reason": { "enum": ["digest-timeout", "imported", "reply", "ruling", "not-ready"], "description": "why the state moved; deferred carries digest-timeout" }
      },
      "required": ["message", "state", "by", "version"],
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "if": {"properties": {"state": {"const": "answered"}}}, "then": {"properties": {"code": {"const": 200}}} },
        {
          "if": { "properties": {"state": {"const": "stale"}} },
          "then": { "properties": {"code": {"const": 500}}, "required": ["elapsed_seconds"] }
        },
        {
          "if": { "properties": {"state": {"enum": ["accepted", "routed", "consumed", "deferred"]}} },
          "then": { "properties": {"code": {"const": 100}} }
        }
      ]
    },
    "reply": {
      "title": "reply (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "reply" },
        "code": { "const": 200 },
        "answer": { "$ref": "#/$defs/messageId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 32000 },
        "by": { "type": "string", "minLength": 1, "maxLength": 64 },
        "links": { "type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/url"} },
        "sitrep": { "type": "boolean", "description": "true when text is a #SITREP/v1# payload that passed the sitrep check" }
      },
      "required": ["answer", "text", "by"]
    },
    "reply.refused": {
      "title": "reply.refused (output, to the sender)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "reply.refused" },
        "code": { "const": 400 },
        "answer": { "$ref": "#/$defs/messageId" },
        "by": { "type": "string" },
        "violations": { "type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 240} }
      },
      "required": ["answer", "by", "violations"]
    },
    "message.rejected": {
      "title": "message.rejected (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "message.rejected" },
        "code": { "const": 400 },
        "message": { "type": "string", "maxLength": 64 },
        "reason": { "enum": ["over-cap", "bad-id", "too-many-files", "unknown-tier"] }
      },
      "required": ["message", "reason"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/owner.message" },
    { "$ref": "#/$defs/routed.message" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/reply" },
    { "$ref": "#/$defs/reply.refused" },
    { "$ref": "#/$defs/message.rejected" },
    {
      "title": "message.stale / inbox.unroutable / reply.failed / inbox.unavailable (alerts)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "enum": ["message.stale", "inbox.unroutable", "reply.failed", "inbox.unavailable"] },
        "code": { "enum": [500, 503] },
        "message": { "$ref": "#/$defs/messageId" },
        "lane": { "$ref": "#/$defs/lane" },
        "stale_count": { "type": "integer", "minimum": 1, "maximum": 2 },
        "error": { "type": "string", "maxLength": 240 }
      },
      "required": ["message"]
    }
  ]
}

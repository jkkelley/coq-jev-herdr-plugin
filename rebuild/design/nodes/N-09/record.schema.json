{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coq.factory/rebuild/design/nodes/N-09/record.schema.json",
  "title": "N-09 Merge: input and output records",
  "description": "Inputs gate.verdict (../N-08/record.schema.json#/$defs/gate_verdict) and review.passed (N-19, repeated here); outputs merge (fix_for_hold_id when merged under a hold), merge.conflict, merge.failed, merge.held, merge.hold.aged. Base shape as in ../N-07/record.schema.json#/$defs/base. Times are UTC. Written 2026-10-14 UTC by the G2 spec-author seat; revised round 3 2026-10-14 UTC.",
  "oneOf": [
    { "$ref": "../N-08/record.schema.json#/$defs/gate_verdict" },
    { "$ref": "#/$defs/review_passed" },
    { "$ref": "#/$defs/merge" },
    { "$ref": "#/$defs/merge_conflict" },
    { "$ref": "#/$defs/merge_failed" },
    { "$ref": "#/$defs/merge_held" },
    { "$ref": "#/$defs/merge_hold_aged" }
  ],
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "base": { "$ref": "../N-07/record.schema.json#/$defs/base" },
    "review_passed": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "review.passed" },
        "code": { "const": 201 },
        "node": { "const": "N-19" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "lease_token": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string" },
        "dispatch_id": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" }, "description": "acceptance criteria evidenced, one line each" }
      },
      "required": ["pr", "ticket", "head_sha", "lease_token", "run_id"]
    },
    "merge": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "merge" },
        "code": { "const": 200 },
        "node": { "const": "N-09" },
        "idempotency_key": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{40}$" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "merge_sha": { "$ref": "#/$defs/sha" },
        "merge_seq": { "type": "integer", "minimum": 1 },
        "branch": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "gate_verdict_id": { "type": "string" },
        "review_record_id": { "type": "string" },
        "already_merged": { "type": "boolean", "description": "true when step 6 completed a merge that landed before the record" },
        "fix_for_hold_id": { "type": "string", "description": "the merge.hold hold_id this merge was allowed under (step 2 exception); absent for a normal merge" }
      },
      "required": ["idempotency_key", "pr", "ticket", "head_sha", "merge_sha", "merge_seq", "branch", "paths", "gate_verdict_id", "review_record_id"]
    },
    "merge_conflict": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "merge.conflict" },
        "code": { "const": 409 },
        "node": { "const": "N-09" },
        "idempotency_key": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{40}:conflict$" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "base_sha": { "$ref": "#/$defs/sha" },
        "phase": { "const": "worker" },
        "instruction": { "const": "merge-main" }
      },
      "required": ["idempotency_key", "pr", "ticket", "head_sha", "base_sha", "phase", "instruction"]
    },
    "merge_failed": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "merge.failed" },
        "code": { "const": 500 },
        "node": { "const": "N-09" },
        "idempotency_key": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{40}:failed:[1-3]$" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "reason": { "type": "string", "enum": ["github-unreachable", "refused-by-branch-rule", "unknown-outcome", "read-back-failed"] },
        "github_status": { "type": "integer" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "phase": { "const": "merge" }
      },
      "required": ["idempotency_key", "pr", "ticket", "head_sha", "reason", "attempts", "phase"]
    },
    "merge_held": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "merge.held" },
        "code": { "const": 423 },
        "node": { "const": "N-09" },
        "idempotency_key": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{40}:held:[a-z-]+$" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "reason": { "type": "string", "enum": ["merge-hold", "halt", "stale-review", "draft", "not-mergeable-unknown", "dark"] },
        "hold_record_id": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["idempotency_key", "pr", "ticket", "head_sha", "reason"]
    },
    "merge_hold_aged": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "merge.hold.aged" },
        "code": { "const": 500 },
        "node": { "const": "N-09" },
        "idempotency_key": { "type": "string", "pattern": "^hold:[A-Za-z0-9._-]+:aged$" },
        "hold_id": { "type": "string" },
        "held_sha": { "$ref": "#/$defs/sha" },
        "age_seconds": { "type": "integer", "minimum": 1 },
        "bound_seconds": { "type": "integer", "minimum": 1, "description": "merge.hold_age_alert_seconds at the time of writing, default 14400" },
        "held_prs": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "pull requests with merge.held merge-hold newest under this hold" }
      },
      "required": ["idempotency_key", "hold_id", "held_sha", "age_seconds", "bound_seconds", "held_prs"]
    }
  }
}

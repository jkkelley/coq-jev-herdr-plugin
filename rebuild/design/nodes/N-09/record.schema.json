{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-09/record.schema.json",
  "title": "N-09 Merge: input and output records",
  "description": "Book 1.1.0 (F08, F09, F10, F13, F16, review C new 1 and 7). Inputs gate.verdict (../N-08/record.schema.json#/$defs/gate_verdict) and review.passed (N-19's record; the fields this node relies on are required here, with the lease as shared/contracts.schema.json#/$defs/lease_ref); outputs merge (parent_main, base_sha, the paths from forge_pr_files, fix_for_hold_id or bootstrap_step when it applies), branch.update, merge.conflict, merge.failed, merge.held, merge.hold.aged. Base shape ../N-07/record.schema.json#/$defs/base: the shared committed envelope, whose id is the UTC-stamp form (shared/state-store.schema.json#/$defs/id). Every idempotency_key is an operation key of shared/contracts.xml#operation-keys. Times are UTC.",
  "oneOf": [
    { "$ref": "../N-08/record.schema.json#/$defs/gate_verdict" },
    { "$ref": "#/$defs/review_passed" },
    { "$ref": "#/$defs/merge" },
    { "$ref": "#/$defs/branch_update" },
    { "$ref": "#/$defs/merge_conflict" },
    { "$ref": "#/$defs/merge_failed" },
    { "$ref": "#/$defs/merge_held" },
    { "$ref": "#/$defs/merge_hold_aged" }
  ],
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "record_id": { "$ref": "../../shared/state-store.schema.json#/$defs/id" },
    "base": { "$ref": "../N-07/record.schema.json#/$defs/base" },
    "op_key": { "$ref": "../../shared/contracts.schema.json#/$defs/operation_key" },
    "review_passed": {
      "description": "the subset of N-19's review.passed this node relies on; the lease names the reviewer seat lease and its token (N-01 refused the record if the token was not current, 412)",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "review.passed" },
            "code": { "const": 201 },
            "node": { "const": "N-19" },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "lease": { "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref" },
            "run_id": { "type": "string", "minLength": 1 },
            "dispatch_id": { "type": "string" },
            "gate_verdict_ref": { "$ref": "#/$defs/record_id" }
          },
          "required": ["pr", "ticket", "head_sha", "lease", "run_id"]
        }
      ]
    },
    "merge": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merge" },
            "code": { "const": 200 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/merge/[0-9]+@[0-9a-f]{40}/r1$" } ] },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "base_sha": { "$ref": "#/$defs/sha", "description": "the pull request's base sha (GET pulls/N base.sha) when the merge was decided" },
            "merge_sha": { "$ref": "#/$defs/sha" },
            "parent_main": { "$ref": "#/$defs/sha", "description": "the first parent of merge_sha: the main sha this merge landed on, read back from GitHub" },
            "merge_seq": { "type": "integer", "minimum": 1 },
            "branch": { "type": "string" },
            "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 3000, "description": "forge_pr_files of (pr, head_sha), N-04" },
            "gate_verdict_id": { "$ref": "#/$defs/record_id" },
            "review_record_id": { "$ref": "#/$defs/record_id" },
            "already_merged": { "type": "boolean", "description": "true when the merge was found landed by the reconcile step (lost reply)" },
            "fix_for_hold_id": { "type": "string", "description": "the merge.hold hold_id this merge was allowed under (fix exception); absent for a normal merge" },
            "bootstrap_step": { "type": "string", "pattern": "^B[2-7]$", "description": "the bootstrap state this merge was allowed under the owner hold for (shared/cut-over.xml#bootstrap-merge); absent otherwise" }
          },
          "required": ["idempotency_key", "pr", "ticket", "head_sha", "base_sha", "merge_sha", "parent_main", "merge_seq", "branch", "paths", "gate_verdict_id", "review_record_id"],
          "not": { "required": ["fix_for_hold_id", "bootstrap_step"] }
        }
      ]
    },
    "branch_update": {
      "description": "PUT pulls/N/update-branch with expected_head_sha answered 202: GitHub will push a new head that needs its own gate and review",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "branch.update" },
            "code": { "const": 100 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/branch\\.update/[0-9]+@[0-9a-f]{40}/r1$" } ] },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha", "description": "the expected_head_sha sent" },
            "base_sha": { "$ref": "#/$defs/sha" },
            "main_sha": { "$ref": "#/$defs/sha" },
            "updates_this_hour": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "required": ["idempotency_key", "pr", "ticket", "head_sha", "main_sha", "updates_this_hour"]
        }
      ]
    },
    "merge_conflict": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merge.conflict" },
            "code": { "const": 409 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/merge\\.conflict/[0-9]+@[0-9a-f]{40}/r1$" } ] },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "base_sha": { "$ref": "#/$defs/sha" },
            "source": { "type": "string", "enum": ["mergeable-state-dirty", "update-branch-conflict"] },
            "phase": { "const": "worker" },
            "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
            "outcome": { "const": "conflict" },
            "failure_kind": { "const": "merge.conflict" },
            "instruction": { "const": "merge-main" }
          },
          "required": ["idempotency_key", "pr", "ticket", "head_sha", "base_sha", "source", "phase", "attempt", "outcome", "failure_kind", "instruction"]
        }
      ]
    },
    "merge_failed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merge.failed" },
            "code": { "const": 500 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/merge\\.failed/[0-9]+@[0-9a-f]{40}/r1$" } ] },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "reason": { "type": "string", "enum": ["github-unreachable", "refused-by-branch-rule", "unknown-outcome", "read-back-failed", "closed-unmerged"] },
            "github_status": { "type": "integer" },
            "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
            "effect_op_id": { "$ref": "#/$defs/op_key" }
          },
          "required": ["idempotency_key", "pr", "ticket", "head_sha", "reason", "attempts"]
        }
      ]
    },
    "merge_held": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merge.held" },
            "code": { "const": 423 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/merge\\.held/[0-9]+@[0-9a-f]{40}@[a-z-]+/r[1-9]$" } ] },
            "pr": { "type": "integer", "minimum": 1 },
            "ticket": { "$ref": "#/$defs/ticket" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "reason": {
              "type": "string",
              "enum": ["merge-hold", "owner-hold", "stale-review", "draft", "not-mergeable-unknown", "awaiting-owner-confirm", "awaiting-verify", "protection-unverified", "protection-mismatch", "files-unknown", "update-branch-limit", "dark"]
            },
            "hold_record_id": { "$ref": "#/$defs/record_id" },
            "unverified_merge_seq": { "type": "integer", "minimum": 1, "description": "awaiting-verify: the merge on main that has neither verified nor rejected" },
            "count": { "type": "integer", "minimum": 1 }
          },
          "required": ["idempotency_key", "pr", "ticket", "head_sha", "reason"]
        }
      ]
    },
    "merge_hold_aged": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merge.hold.aged" },
            "code": { "const": 500 },
            "node": { "const": "N-09" },
            "idempotency_key": { "allOf": [ { "$ref": "#/$defs/op_key" }, { "pattern": "^N-09/merge\\.hold\\.aged/[A-Za-z0-9._:-]+/r1$" } ] },
            "hold_id": { "type": "string" },
            "held_sha": { "$ref": "#/$defs/sha" },
            "age_seconds": { "type": "integer", "minimum": 1 },
            "bound_seconds": { "type": "integer", "minimum": 1, "description": "merge.hold_age_alert_seconds at the time of writing" },
            "held_prs": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "pull requests with merge.held merge-hold newest under this hold" }
          },
          "required": ["idempotency_key", "hold_id", "held_sha", "age_seconds", "bound_seconds", "held_prs"]
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coq.factory/rebuild/design/nodes/N-07/record.schema.json",
  "title": "N-07 Scheduler tick and dispatch: input and output records",
  "description": "Inputs: the tick:scheduler entity (../N-06/record.schema.json#/$defs/tick) and lease.granted (../N-02/record.schema.json#/$defs/lease_granted); outputs dispatch, dispatch.refused and the sched:tick entity (tick_done). Every record extends base. Times are UTC strings 2006-01-02T15:04:05Z. Written 2026-10-14 UTC by the G2 spec-author seat; the shared store volume (../../shared/state-store.xml#table-records) owns the base shape and this file repeats it so the volume is whole on its own. The local tick and lease defs below are the fields this node reads, kept as a projection of the owners' schemas.",
  "oneOf": [
    { "$ref": "../N-06/record.schema.json#/$defs/tick" },
    { "$ref": "../N-02/record.schema.json#/$defs/lease_granted" },
    { "$ref": "#/$defs/dispatch" },
    { "$ref": "#/$defs/dispatch_refused" },
    { "$ref": "#/$defs/tick_done" }
  ],
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "UTC to the second with a Z suffix" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "phase": { "type": "string", "enum": ["worker", "reviewer", "spec", "gate"] },
    "role": { "type": "string", "enum": ["worker", "reviewer", "spec-author", "gate"] },
    "lane": { "type": "string", "enum": ["build", "verify", "system"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "base": {
      "type": "object",
      "required": ["id", "at", "code", "kind", "node", "seq"],
      "properties": {
        "id": { "type": "string", "description": "UTC stamp, code and a five character suffix, minted by N-01", "pattern": "^[0-9]{8}T[0-9]{6}Z-[1-5][0-9]{2}-[a-z0-9]{5}$" },
        "at": { "$ref": "#/$defs/at" },
        "code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "kind": { "type": "string" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$", "description": "the node that wrote it" },
        "seq": { "type": "integer", "minimum": 1, "description": "store sequence from record.committed" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "idempotency_key": { "type": "string" },
        "note": { "type": "string", "maxLength": 240, "description": "prose for humans; no node branches on it" }
      }
    },
    "tick": {
      "description": "Projection of ../N-06/record.schema.json#/$defs/tick: the fields this node reads from the tick:scheduler entity.",
      "type": "object",
      "properties": {
        "subkind": { "const": "scheduler" },
        "at": { "$ref": "#/$defs/at" },
        "n": { "type": "integer", "minimum": 1 },
        "interval_seconds": { "type": "integer", "minimum": 1, "default": 5 }
      },
      "required": ["subkind", "at", "n", "interval_seconds"]
    },
    "lease": {
      "description": "Projection of ../N-02/record.schema.json#/$defs/lease_body: the fields this node reads from a lease.granted record; not_before is joined from ../N-11/record.schema.json#/$defs/attempt by key.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "ticket:phase:attempt, N-02 lease_key" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "phase": { "$ref": "#/$defs/phase" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "role": { "$ref": "#/$defs/role" },
        "holder": { "type": "string", "description": "empty until N-07 sets it to the dispatch id by compare-and-swap" },
        "token": { "type": "integer", "minimum": 1, "description": "the fencing token" },
        "generation": { "type": "integer", "minimum": 1 },
        "granted_at": { "$ref": "#/$defs/at" },
        "expires_at": { "$ref": "#/$defs/at" },
        "heartbeat_seconds": { "type": "integer", "minimum": 1, "default": 30 },
        "lane": { "$ref": "#/$defs/lane" },
        "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] }
      },
      "required": ["key", "ticket", "phase", "attempt", "role", "token", "generation", "expires_at"]
    },
    "dispatch": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "dispatch" },
        "code": { "const": 100 },
        "node": { "const": "N-07" },
        "dispatch_id": { "type": "string" },
        "idempotency_key": { "type": "string", "pattern": "^(WO-[0-9]{8}-[0-9a-f]{4}|CR-[a-z0-9._-]+):(worker|reviewer|spec|gate):[1-3]$", "description": "ticket, colon, phase, colon, attempt" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "role": { "$ref": "#/$defs/role" },
        "phase": { "$ref": "#/$defs/phase" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "deadline": { "$ref": "#/$defs/at" },
        "lease_key": { "type": "string" },
        "lease_token": { "type": "integer", "minimum": 1, "description": "the lease token at dispatch" },
        "brief_path": { "type": "string", "pattern": "^/.*/briefs/[0-9]{4}/[0-9]{2}/[0-9]{14}-WO-[0-9]{8}-[0-9a-f]{4}-[a-z-]+-[1-3]\\.md$" },
        "lane": { "$ref": "#/$defs/lane" },
        "not_before": { "$ref": "#/$defs/at" },
        "build_mode": { "type": "boolean", "description": "the N-44 state at dispatch time, passed to N-13" },
        "claimed_by": { "type": "string", "description": "set by N-15 by compare-and-swap; empty when written" }
      },
      "required": ["dispatch_id", "idempotency_key", "ticket", "role", "phase", "attempt", "deadline", "lease_key", "lease_token", "brief_path", "lane"]
    },
    "dispatch_refused": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "dispatch.refused" },
        "code": { "const": 412 },
        "node": { "const": "N-07" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "phase": { "$ref": "#/$defs/phase" },
        "attempt": { "$ref": "#/$defs/attempt" },
        "lease_key": { "type": "string" },
        "reason": { "type": "string", "enum": ["role-unknown", "brief-missing", "files-claimed", "address-unknown"] },
        "outcome": { "const": "refused" },
        "detail": { "type": "string", "maxLength": 240 }
      },
      "required": ["ticket", "phase", "attempt", "lease_key", "reason", "outcome"]
    },
    "tick_done": {
      "description": "The sched:tick entity, compare-and-swap written every tick; version grows; never a log record.",
      "type": "object",
      "properties": {
        "entity": { "const": "sched:tick" },
        "kind": { "const": "sched.tick" },
        "code": { "const": 100 },
        "node": { "const": "N-07" },
        "at": { "$ref": "#/$defs/at" },
        "version": { "type": "integer", "minimum": 1 },
        "n": { "type": "integer", "minimum": 1 },
        "leader": { "type": "boolean" },
        "counts": {
          "type": "object",
          "required": ["desired", "live", "dispatched", "held_by_cap", "held_by_hold", "refused"],
          "properties": {
            "desired": { "type": "integer", "minimum": 0 },
            "live": { "type": "integer", "minimum": 0 },
            "dispatched": { "type": "integer", "minimum": 0 },
            "held_by_cap": { "type": "integer", "minimum": 0 },
            "held_by_hold": { "type": "integer", "minimum": 0 },
            "refused": { "type": "integer", "minimum": 0 },
            "conflicts_409": { "type": "integer", "minimum": 0 }
          }
        },
        "snapshot_ok": { "type": "boolean", "description": "false when the store read timed out and counts are unknown" }
      },
      "required": ["entity", "at", "version", "n", "leader", "counts", "snapshot_ok"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coq/rebuild/design/nodes/N-04/record.schema.json",
  "title": "N-04 GitHub poll records",
  "description": "Input poll tick (defined in ../N-06/record.schema.json) and forge.poll_now; output forge.snapshot, forge.unreachable, forge.recovered, forge.throttled, forge.auth, forge.overflow, forge.slow, forge.started of node N-04. Parent volume: spec.xml#N-04. UTC everywhere.",
  "$defs": {
    "envelope": { "$ref": "../N-01/record.schema.json#/$defs/envelope" },
    "at": { "$ref": "../N-01/record.schema.json#/$defs/at" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "$ref": "../N-01/record.schema.json#/$defs/sha256" },
    "gate_state": {
      "enum": ["success", "failure", "error", "pending", "none"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/gate_state" },
        "description": { "type": "string", "maxLength": 240 },
        "target_url": { "type": "string", "maxLength": 500 },
        "updated_at": { "$ref": "#/$defs/at" },
        "superseded": {
          "type": "boolean",
          "description": "true when description says superseded by a newer build (ci/README.md)"
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "head_sha",
        "head_ref",
        "base_ref",
        "mergeable",
        "gate",
        "draft"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "$ref": "#/$defs/sha" },
        "head_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "base_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mergeable": { "enum": ["true", "false", "unknown"] },
        "gate": { "$ref": "#/$defs/gate" },
        "gate_page": { "$ref": "#/$defs/gate" },
        "draft": { "type": "boolean" },
        "ticket": {
          "oneOf": [
            { "$ref": "../N-01/record.schema.json#/$defs/ticket" },
            { "type": "null" }
          ]
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20
        },
        "statuses_deferred": {
          "type": "boolean",
          "description": "true when the call budget ran out before this head's status was read"
        }
      }
    },
    "poll_tick": { "$ref": "../N-06/record.schema.json#/$defs/tick" },
    "forge_poll_now": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "reason"],
      "properties": {
        "by": { "enum": ["N-09", "N-16", "ctl"] },
        "reason": { "type": "string", "maxLength": 240 }
      }
    },
    "forge_snapshot": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "main_sha",
            "main_gate",
            "prs",
            "hash",
            "polled_at",
            "stale",
            "calls",
            "rate_remaining"
          ],
          "properties": {
            "kind": { "const": "forge.snapshot" },
            "code": { "const": 200 },
            "node": { "const": "N-04" },
            "main_sha": { "$ref": "#/$defs/sha" },
            "main_gate": { "$ref": "#/$defs/gate" },
            "prs": {
              "type": "array",
              "maxItems": 200,
              "items": { "$ref": "#/$defs/pr" }
            },
            "hash": { "$ref": "#/$defs/sha256" },
            "polled_at": { "$ref": "#/$defs/at" },
            "stale": { "const": false },
            "calls": { "type": "integer", "minimum": 0 },
            "rate_remaining": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "forge_entity": {
      "description": "the entity forge:snapshot body; same as the record body plus staleness fields",
      "allOf": [
        { "$ref": "#/$defs/forge_snapshot" },
        {
          "type": "object",
          "properties": {
            "stale": { "type": "boolean" },
            "failed_since": { "$ref": "#/$defs/at" },
            "etags": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },
    "forge_report": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "kind": {
              "enum": [
                "forge.started",
                "forge.recovered",
                "forge.unreachable",
                "forge.throttled",
                "forge.auth",
                "forge.overflow",
                "forge.slow"
              ]
            },
            "code": { "enum": [100, 200, 400, 429, 500, 503] },
            "node": { "const": "N-04" },
            "reason": { "type": "string", "maxLength": 240 },
            "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
            "failed_since": { "$ref": "#/$defs/at" },
            "outage_seconds": { "type": "integer", "minimum": 0 },
            "reset_at": { "$ref": "#/$defs/at" },
            "rate_remaining": { "type": "integer", "minimum": 0 },
            "open_prs": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/poll_tick" },
    { "$ref": "#/$defs/forge_poll_now" },
    { "$ref": "#/$defs/forge_snapshot" },
    { "$ref": "#/$defs/forge_report" }
  ]
}

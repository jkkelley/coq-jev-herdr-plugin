{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-34/record.schema.json",
  "title": "N-34 Tailnet front door: input and output records",
  "description": "page.up (input, schema owned by ../N-32/record.schema.json) and the front-door records. Envelope per shared/state-store.xml#envelope. No record ever carries the page key.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "recordId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "page": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "tier": { "enum": ["stable", "uat", "dev"] },
    "tailscaleIPv4": {
      "type": "string",
      "pattern": "^100\\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3}$",
      "description": "CGNAT range 100.64.0.0/10 only"
    },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string" },
        "code": { "enum": [100, 200, 201, 204, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-34" },
        "seq": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "maxLength": 128 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "epoch": { "type": "integer", "minimum": 1 }
      },
      "not": { "required": ["key"] }
    },
    "tierFields": {
      "type": "object",
      "required": ["tier", "page"],
      "properties": { "tier": {"$ref": "#/$defs/tier"}, "page": {"$ref": "#/$defs/page"} }
    },
    "page.up": {
      "title": "page.up (input; owned by N-32)",
      "type": "object",
      "required": ["kind", "code", "page", "port", "pid"],
      "properties": {
        "kind": { "const": "page.up" },
        "code": { "const": 100 },
        "node": { "const": "N-32" },
        "page": { "$ref": "#/$defs/page" },
        "port": { "$ref": "#/$defs/port" },
        "pid": { "type": "integer", "minimum": 1 }
      }
    },
    "front-door": {
      "title": "front-door (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "front-door" },
        "code": { "const": 100 },
        "bind": { "$ref": "#/$defs/tailscaleIPv4" },
        "port": { "$ref": "#/$defs/port" },
        "target_port": { "$ref": "#/$defs/port" },
        "pid": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "pattern": "^coq-front-door@[a-z0-9-]+\\.service$" },
        "names": { "type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 128} }
      },
      "required": ["bind", "port", "target_port", "pid", "unit", "names"]
    },
    "front-door.failed": {
      "title": "front-door.failed (output, alert)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "front-door.failed" },
        "code": { "const": 500 },
        "bind": { "type": ["string", "null"] },
        "port": { "$ref": "#/$defs/port" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "reason": { "enum": ["bind", "backend", "no-address", "address-outside-tailnet"] },
        "error": { "type": "string", "maxLength": 240 },
        "exit": { "enum": [1, 3, 4] }
      },
      "required": ["port", "attempts", "reason", "error", "exit"]
    },
    "front-door.refused": {
      "title": "front-door.refused (output: second instance, 412, exit 4)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "front-door.refused" },
        "code": { "const": 412 },
        "holder_pid": { "type": "integer", "minimum": 1 },
        "exit": { "const": 4 }
      },
      "required": ["holder_pid"]
    },
    "front-door.rebind": {
      "title": "front-door.rebind (output: Tailscale IP changed)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "front-door.rebind" },
        "code": { "const": 100 },
        "old_bind": { "$ref": "#/$defs/tailscaleIPv4" },
        "new_bind": { "$ref": "#/$defs/tailscaleIPv4" }
      },
      "required": ["old_bind", "new_bind"]
    },
    "front-door.down": {
      "title": "front-door.down (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "front-door.down" },
        "code": { "enum": [100, 500] },
        "reason": { "enum": ["stop", "crash", "page-stopped"] }
      },
      "required": ["reason"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/page.up" },
    { "$ref": "#/$defs/front-door" },
    { "$ref": "#/$defs/front-door.failed" },
    { "$ref": "#/$defs/front-door.refused" },
    { "$ref": "#/$defs/front-door.rebind" },
    { "$ref": "#/$defs/front-door.down" }
  ]
}

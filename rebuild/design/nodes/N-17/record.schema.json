{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-17/record.schema.json",
  "title": "N-17 Spec-author run: structured output and output record",
  "description": "Book 1.1.0. Input: seat.result done for a spec-author run (../N-15/record.schema.json#/$defs/seat.result) on a CR ticket. The seat returns spec-author.output as structured output (N-13 copies it into the bundle's output.schema.json). The draft put, in the service as N-17, writes ticket-set.draft on the shared committed envelope (operation key N-17/ticket-set.draft/<run_id>/r1 on the request), consumed by N-18. draft_ticket and acceptance are the drafting shapes; the accepted ticket is ../N-18/record.schema.json#/$defs/ticket.",
  "$defs": {
    "utc": {
      "$ref": "../../shared/contracts.schema.json#/$defs/at"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ticket_id": {
      "$ref": "../../shared/contracts.schema.json#/$defs/wo_id"
    },
    "key": {
      "type": "string",
      "pattern": "^t[0-9]{1,3}$"
    },
    "anchor": {
      "type": "string",
      "pattern": "^rebuild/design/(nodes/N-[0-9]{2}/[a-z-]+\\.xml|shared/[a-z-]+\\.xml|index\\.xml|dag\\.md)(#[A-Za-z0-9_.-]+)?$"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "id",
        "command",
        "runs_in",
        "expect_exit",
        "proves"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a[0-9]{1,2}$"
        },
        "command": {
          "type": "string",
          "minLength": 3,
          "description": "run from the repository root; a make target or a script in the repository"
        },
        "runs_in": {
          "enum": [
            "host",
            "pod"
          ]
        },
        "expect_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "exit after the change"
        },
        "regression_guard": {
          "type": "boolean",
          "default": false,
          "description": "true when the command is expected to pass on main already and must keep passing"
        },
        "proves": {
          "type": "string",
          "description": "the checklist item anchor in the node volume this command proves"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },
        "test_ref": {
          "type": "string",
          "minLength": 3,
          "description": "the test this command runs (path::name or a make target plus test name); a new test names a path in new_paths"
        },
        "expected_failure": {
          "type": "object",
          "required": [
            "exit",
            "match"
          ],
          "properties": {
            "exit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "match": {
              "type": "string",
              "minLength": 3,
              "description": "a regex over the command's output that the red run on main must show: the test fails for the reason the ticket fixes"
            }
          },
          "additionalProperties": false,
          "description": "present when the command is expected red on main (a new or changed test); N-18 refuses a red run whose output does not match (422 wrong_failure_reason)"
        },
        "arch_sensitive": {
          "type": "boolean",
          "default": false,
          "description": "true when the result can differ by CPU architecture: N-18 runs it on the arm64 pod path as well"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "regression_guard": {
                "const": true
              }
            },
            "required": [
              "regression_guard"
            ]
          },
          "then": {
            "not": {
              "required": [
                "expected_failure"
              ]
            }
          }
        }
      ]
    },
    "draft_ticket": {
      "type": "object",
      "required": [
        "key",
        "title",
        "target_node",
        "anchor",
        "concern",
        "files",
        "input_record",
        "output_record",
        "acceptance",
        "depends_on",
        "role",
        "size",
        "steps"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        },
        "target_node": {
          "type": "string",
          "pattern": "^N-[0-9]{2}$",
          "description": "the DAG node this ticket builds (renamed from node, which is an envelope field)"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "concern": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_paths": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "paths the ticket creates that do not exist on main; each must also match a pattern of files; N-18 admits them (check C2) instead of refusing a missing path"
        },
        "input_record": {
          "type": "string",
          "description": "record kind that starts the work"
        },
        "output_record": {
          "type": "string",
          "description": "record kind that proves the work"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/key"
              },
              {
                "$ref": "#/$defs/ticket_id"
              }
            ]
          }
        },
        "role": {
          "const": "worker",
          "description": "a drafted ticket is always worker work; a change to specs or the book is a worker ticket whose files are those volumes"
        },
        "size": {
          "type": "object",
          "required": [
            "files",
            "diff_lines_estimate"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "diff_lines_estimate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        "proof": {
          "type": "string",
          "description": "for an owner-surface or go-live ticket: the named proof (screenshot pattern or first real record)"
        },
        "go_live": {
          "type": "boolean",
          "default": false,
          "description": "true when this ticket flips a dark node live; it must depend on the build ticket"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400
          }
        },
        "degrees_of_freedom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec-author.output": {
      "type": "object",
      "description": "The seat's structured output. Exactly one of tickets or blocked.",
      "oneOf": [
        {
          "required": [
            "tickets",
            "rationale"
          ],
          "properties": {
            "tickets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/draft_ticket"
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 20,
              "maxLength": 3000
            }
          },
          "not": {
            "required": [
              "blocked"
            ]
          }
        },
        {
          "required": [
            "blocked"
          ],
          "properties": {
            "blocked": {
              "type": "object",
              "required": [
                "reason",
                "observations"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "anchor_contradictory",
                    "fully_ticketed",
                    "needs_ruling",
                    "anchor_not_found"
                  ]
                },
                "observations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "saw",
                      "expected"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "line": {
                        "type": "integer"
                      },
                      "saw": {
                        "type": "string"
                      },
                      "expected": {
                        "type": "string"
                      }
                    }
                  }
                },
                "proposed_card": {
                  "type": "object",
                  "required": [
                    "about",
                    "decide",
                    "options",
                    "recommendation"
                  ],
                  "properties": {
                    "about": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "decide": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "options": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "choice",
                          "what_happens"
                        ],
                        "properties": {
                          "choice": {
                            "type": "string"
                          },
                          "what_happens": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "recommendation": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ticket-set.draft": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../shared/state-store.schema.json#/$defs/committed_envelope"
        }
      ],
      "required": [
        "set_id",
        "run_id",
        "cut_request",
        "source_request",
        "anchor",
        "group",
        "attempt",
        "lease",
        "repo_sha",
        "author_session_id",
        "tickets",
        "rationale"
      ],
      "properties": {
        "kind": {
          "const": "ticket-set.draft"
        },
        "code": {
          "const": 100
        },
        "node": {
          "const": "N-17"
        },
        "attempt": {
          "$ref": "../../shared/contracts.schema.json#/$defs/attempt"
        },
        "set_id": {
          "type": "string",
          "pattern": "^d-[0-9]{14}-[a-z0-9]{6}$",
          "description": "equals run_id"
        },
        "run_id": {
          "type": "string",
          "pattern": "^d-[0-9]{14}-[a-z0-9]{6}$"
        },
        "cut_request": {
          "$ref": "../../shared/contracts.schema.json#/$defs/cr_id",
          "description": "the CR ticket this run served (dispatch target.request)"
        },
        "source_request": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9]{3}-[a-z0-9]{5}$",
          "description": "the ticket.request record the CR was admitted from (dispatch target.source_request); N-03 closes the CR by it"
        },
        "lease": {
          "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref",
          "description": "the spec lease the draft put carries and releases"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "group": {
          "type": "string",
          "pattern": "^G[0-9]$"
        },
        "repo_sha": {
          "$ref": "#/$defs/sha1",
          "description": "the sha the anchor text was read at"
        },
        "author_session_id": {
          "type": "string"
        },
        "verdict_refs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          },
          "description": "the validator.refused records this attempt answers"
        },
        "tickets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/draft_ticket"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/spec-author.output"
    },
    {
      "$ref": "#/$defs/ticket-set.draft"
    }
  ]
}

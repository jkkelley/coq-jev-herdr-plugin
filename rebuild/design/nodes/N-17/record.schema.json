{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-17/record.schema.json",
  "title": "N-17 Spec-author run: structured output and output record",
  "description": "Input: the spec-author brief inside a seat run (bundle plus a read-only workspace). The seat returns spec-author.output as structured output (copied by N-13 into bundle output.schema.json); the launcher's post step wraps it as the ticket-set.draft record consumed by N-18.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ticket_id": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "key": { "type": "string", "pattern": "^t[0-9]{1,3}$" },
    "anchor": { "type": "string", "pattern": "^rebuild/design/(nodes/N-[0-9]{2}/[a-z-]+\\.xml|shared/[a-z-]+\\.xml|index\\.xml|dag\\.md)(#[A-Za-z0-9_.-]+)?$" },
    "acceptance": {
      "type": "object",
      "required": ["id", "command", "runs_in", "expect_exit", "proves"],
      "properties": {
        "id": { "type": "string", "pattern": "^a[0-9]{1,2}$" },
        "command": { "type": "string", "minLength": 3, "description": "run from the repository root; a make target or a script in the repository" },
        "runs_in": { "enum": ["host", "pod"] },
        "expect_exit": { "type": "integer", "minimum": 0, "maximum": 255, "description": "exit after the change" },
        "regression_guard": { "type": "boolean", "default": false, "description": "true when the command is expected to pass on main already and must keep passing" },
        "proves": { "type": "string", "description": "the checklist item anchor in the node volume this command proves" },
        "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800 }
      }
    },
    "draft_ticket": {
      "type": "object",
      "required": ["key", "title", "node", "anchor", "concern", "files", "input_record", "output_record", "acceptance", "depends_on", "role", "size", "steps"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 10, "maxLength": 160 },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "concern": { "type": "string", "minLength": 10, "maxLength": 300 },
        "files": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "input_record": { "type": "string", "description": "record kind that starts the work" },
        "output_record": { "type": "string", "description": "record kind that proves the work" },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptance" } },
        "depends_on": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/key" }, { "$ref": "#/$defs/ticket_id" }] } },
        "role": { "enum": ["worker", "spec-author"] },
        "size": {
          "type": "object",
          "required": ["files", "diff_lines_estimate"],
          "properties": {
            "files": { "type": "integer", "minimum": 1, "maximum": 6 },
            "diff_lines_estimate": { "type": "integer", "minimum": 1, "maximum": 600 }
          }
        },
        "proof": { "type": "string", "description": "for an owner-surface or go-live ticket: the named proof (screenshot pattern or first real record)" },
        "go_live": { "type": "boolean", "default": false, "description": "true when this ticket flips a dark node live; it must depend on the build ticket" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 400 } },
        "degrees_of_freedom": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spec-author.output": {
      "type": "object",
      "description": "The seat's structured output. Exactly one of tickets or blocked.",
      "oneOf": [
        {
          "required": ["tickets", "rationale"],
          "properties": {
            "tickets": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/draft_ticket" } },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 3000 }
          },
          "not": { "required": ["blocked"] }
        },
        {
          "required": ["blocked"],
          "properties": {
            "blocked": {
              "type": "object",
              "required": ["reason", "observations"],
              "properties": {
                "reason": { "enum": ["anchor_contradictory", "fully_ticketed", "needs_ruling", "anchor_not_found"] },
                "observations": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "saw", "expected"], "properties": { "path": { "type": "string" }, "line": { "type": "integer" }, "saw": { "type": "string" }, "expected": { "type": "string" } } } },
                "proposed_card": {
                  "type": "object",
                  "required": ["about", "decide", "options", "recommendation"],
                  "properties": {
                    "about": { "type": "string", "maxLength": 400 },
                    "decide": { "type": "string", "maxLength": 300 },
                    "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "required": ["choice", "what_happens"], "properties": { "choice": { "type": "string" }, "what_happens": { "type": "string" } } } },
                    "recommendation": { "type": "integer", "minimum": 0, "maximum": 3 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ticket-set.draft": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "idempotency_key", "set_id", "anchor", "group", "attempt", "repo_sha", "author_session_id", "tickets", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "kind": { "const": "ticket-set.draft" },
        "code": { "const": 100 },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-17" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "idempotency_key": { "type": "string", "description": "equals run_id" },
        "version": { "type": "integer", "minimum": 0 },
        "set_id": { "type": "string", "description": "equals run_id" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "group": { "type": "string", "pattern": "^G[1-7]$" },
        "repo_sha": { "$ref": "#/$defs/sha1", "description": "the sha the anchor text was read at" },
        "author_session_id": { "type": "string" },
        "verdict_ref": { "type": "string", "description": "the validator.refused record id this attempt answers" },
        "tickets": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/draft_ticket" } },
        "rationale": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/spec-author.output" },
    { "$ref": "#/$defs/ticket-set.draft" }
  ]
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rebuild/design/nodes/N-22/record.schema.json",
 "title": "N-22 Image build: input image.config and output image",
 "description": "Book 1.1.0 (F06, F24, F25, review C new 10). Envelope: shared/state-store.schema.json#/$defs/envelope (UTC-stamp ids). The builder pin is shared/ci-capacity.xml#builder-pin. UTC everywhere.",
 "oneOf": [
  {
   "$ref": "#/$defs/input"
  },
  {
   "$ref": "#/$defs/output"
  },
  {
   "$ref": "#/$defs/failed"
  }
 ],
 "$defs": {
  "envelope": {
   "$ref": "../../shared/state-store.schema.json#/$defs/envelope"
  },
  "sha40": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "name": {
   "type": "string",
   "enum": [
    "coq-test",
    "coq-lint",
    "coq-go",
    "coq-bearings",
    "coq-jenkins",
    "coq-map"
   ]
  },
  "platform": {
   "type": "string",
   "enum": [
    "linux/arm64",
    "linux/amd64"
   ]
  },
  "input": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "sha",
      "name",
      "version",
      "platforms",
      "inputs_hash",
      "base",
      "binaries",
      "containerfile"
     ],
     "properties": {
      "kind": {
       "const": "image.config"
      },
      "code": {
       "const": 100
      },
      "node": {
       "const": "N-22"
      },
      "sha": {
       "$ref": "#/$defs/sha40"
      },
      "name": {
       "$ref": "#/$defs/name"
      },
      "version": {
       "type": "string",
       "pattern": "^[0-9A-Za-z._-]+$"
      },
      "platforms": {
       "type": "array",
       "minItems": 1,
       "uniqueItems": true,
       "items": {
        "$ref": "#/$defs/platform"
       },
       "contains": {
        "const": "linux/arm64"
       }
      },
      "inputs_hash": {
       "$ref": "#/$defs/sha256"
      },
      "base": {
       "type": "string",
       "pattern": "@sha256:[0-9a-f]{64}$"
      },
      "containerfile": {
       "type": "string",
       "pattern": "^(ci/images/[a-z-]+/Containerfile|ci/image/Containerfile|lint/Containerfile|ci/jenkins/Containerfile)$"
      },
      "binaries": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "name",
         "version",
         "sha256"
        ],
        "properties": {
         "name": {
          "type": "string"
         },
         "version": {
          "type": "string"
         },
         "sha256": {
          "type": "object",
          "properties": {
           "arm64": {
            "$ref": "#/$defs/sha256"
           },
           "amd64": {
            "$ref": "#/$defs/sha256"
           }
          },
          "required": [
           "arm64"
          ]
         }
        }
       }
      }
     }
    }
   ]
  },
  "output": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "name",
      "version",
      "inputs_hash",
      "manifest_digest",
      "per_platform",
      "checksums_verified",
      "pushed_at",
      "builder"
     ],
     "properties": {
      "kind": {
       "const": "image"
      },
      "code": {
       "const": 201
      },
      "node": {
       "const": "N-22"
      },
      "name": {
       "$ref": "#/$defs/name"
      },
      "version": {
       "type": "string"
      },
      "inputs_hash": {
       "$ref": "#/$defs/sha256"
      },
      "manifest_digest": {
       "$ref": "#/$defs/digest"
      },
      "per_platform": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "platform",
         "digest",
         "built_on",
         "build_log",
         "duration_s"
        ],
        "properties": {
         "platform": {
          "$ref": "#/$defs/platform"
         },
         "digest": {
          "$ref": "#/$defs/digest"
         },
         "built_on": {
          "type": "string",
          "enum": [
           "cluster",
           "host"
          ]
         },
         "build_log": {
          "type": "string"
         },
         "duration_s": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      },
      "checksums_verified": {
       "const": true
      },
      "pushed_at": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
      },
      "builder": {
       "type": "object",
       "required": [
        "tool",
        "digest"
       ],
       "properties": {
        "tool": {
         "enum": [
          "kaniko",
          "buildkit"
         ]
        },
        "digest": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       },
       "description": "the builder image the cluster leg ran, equal to shared/ci-capacity.xml#builder-pin"
      }
     }
    }
   ]
  },
  "failed": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "name",
      "version",
      "inputs_hash",
      "reason",
      "log"
     ],
     "properties": {
      "kind": {
       "const": "image.failed"
      },
      "code": {
       "enum": [
        422,
        500
       ]
      },
      "node": {
       "const": "N-22"
      },
      "name": {
       "$ref": "#/$defs/name"
      },
      "version": {
       "type": "string"
      },
      "inputs_hash": {
       "$ref": "#/$defs/sha256"
      },
      "reason": {
       "type": "string",
       "enum": [
        "checksum",
        "build-step",
        "smoke",
        "infrastructure"
       ]
      },
      "log": {
       "type": "string"
      },
      "partial": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "platform": {
          "$ref": "#/$defs/platform"
         },
         "digest": {
          "$ref": "#/$defs/digest"
         }
        }
       }
      }
     }
    }
   ]
  }
 }
}

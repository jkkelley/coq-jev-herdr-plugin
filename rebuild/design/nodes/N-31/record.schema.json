{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-31/record.schema.json",
  "title": "N-31 Push transport: input and output records, and the frame",
  "description": "record.committed (input, the store's stream), the frame sent to clients (not stored), and pushed.frame (output, per-client watermark) with the transport's events. Envelope per shared/state-store.xml#envelope.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "recordId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "clientClass": { "enum": ["page", "map", "tail"] },
    "cursor": { "$ref": "../../shared/contracts.schema.json#/$defs/cursor" },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string" },
        "code": { "enum": [100, 200, 201, 204, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-31" },
        "seq": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "maxLength": 128 }
      }
    },
    "committedEnvelope": {
      "title": "record.committed (input): any record as committed by N-01",
      "type": "object",
      "required": ["epoch", "seq", "id", "kind", "code", "at", "node", "hash"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 1 },
        "seq": { "type": "integer", "minimum": 1, "description": "strictly increasing within the epoch, not gapless" },
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string" },
        "code": { "enum": [100, 200, 201, 204, 300, 400, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "tier": { "enum": ["stable", "uat", "dev"] },
        "ticket": { "type": ["string", "null"] },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "integer", "minimum": 1 },
        "body": { "type": "object" }
      }
    },
    "frame": {
      "title": "frame (sent to clients, not stored)",
      "type": "object",
      "required": ["kind", "epoch", "store_seq", "at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["frame", "snapshot", "heartbeat"] },
        "epoch": { "type": "integer", "minimum": 1 },
        "from_seq": { "type": "integer", "minimum": 0, "description": "frames only: strictly after the previous frame's to_seq" },
        "to_seq": { "type": "integer", "minimum": 0, "description": "frames: epoch:to_seq is the SSE event id; snapshot: S, the seq of its one read transaction" },
        "store_seq": { "type": "integer", "minimum": 0 },
        "at": { "$ref": "#/$defs/utc" },
        "records": { "type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/committedEnvelope"}, "description": "append-only records apply idempotently by id" },
        "dropped": { "type": "integer", "minimum": 0, "description": "records collapsed by key coalescing" },
        "entities": {
          "type": "array",
          "maxItems": 500,
          "description": "entity-only kinds, coalesced by coalesce_key (shared/contracts.xml#entity-only)",
          "items": {
            "type": "object",
            "required": ["kind", "key", "version", "value"],
            "properties": { "kind": { "type": "string" }, "key": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "value": { "type": "object" } }
          }
        },
        "store_stale": { "type": "boolean", "description": "heartbeat only: the store's own tick is older than 10 s" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "heartbeat" } } }, "then": { "not": { "anyOf": [{ "required": ["records"] }, { "required": ["to_seq"] }] } }, "else": { "required": ["to_seq", "records"] } },
        { "if": { "properties": { "kind": { "const": "frame" } } }, "then": { "required": ["from_seq"] } }
      ]
    },
    "pushed.frame": {
      "title": "pushed.frame (output; entity-only push:<client>, a record only on connect, resync and drop)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "const": "pushed.frame" },
        "code": { "const": 100 },
        "client": { "type": "string", "pattern": "^sub-[a-z0-9]{8,16}$" },
        "class": { "$ref": "#/$defs/clientClass" },
        "tier": { "enum": ["stable", "uat", "dev"] },
        "delivered": { "$ref": "#/$defs/cursor" },
        "acked": { "$ref": "#/$defs/cursor" },
        "event": { "enum": ["connect", "resync", "drop"] },
        "connected_at": { "$ref": "#/$defs/utc" },
        "last_frame_at": { "$ref": "#/$defs/utc" },
        "resyncs": { "type": "integer", "minimum": 0 }
      },
      "required": ["client", "class", "delivered", "event", "connected_at", "resyncs"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/committedEnvelope" },
    { "$ref": "#/$defs/frame" },
    { "$ref": "#/$defs/pushed.frame" },
    {
      "title": "push.subscribed / push.client.dropped / push.snapshot.failed / push.stalled (events)",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": { "enum": ["push.subscribed", "push.client.dropped", "push.snapshot.failed", "push.stalled"] },
        "code": { "enum": [100, 429, 500] },
        "client": { "type": "string" },
        "class": { "$ref": "#/$defs/clientClass" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "reason": { "enum": ["max-pending", "ack-timeout", "send-timeout", "snapshot-timeout", "store-tick-missing"] },
        "pending": { "type": "integer", "minimum": 0 }
      },
      "required": ["kind"]
    }
  ]
}

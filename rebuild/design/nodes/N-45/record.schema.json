{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-45/record.schema.json",
  "title": "N-45 Cleanup registry and runs: input and output records",
  "description": "Parent: ../../index.xml#N-45. Sibling: spec.xml. Book 1.1.0: shared envelope through ../N-43/record.schema.json#/$defs/envelope (NF-A12); the backup input is N-05's own def (NF-D1); a registry entry is shared/cleanup-registry.schema.json#/$defs/entry; plan rows bind device and inode and the drain leases (F24).",
  "oneOf": [{"$ref": "#/$defs/input"}, {"$ref": "#/$defs/output"}],
  "$defs": {
    "utc": {"$ref": "../../shared/state-store.schema.json#/$defs/at"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"$ref": "../../shared/state-store.schema.json#/$defs/sha256"},
    "envelope": {"$ref": "../N-43/record.schema.json#/$defs/envelope"},
    "entry-id": {"type": "string", "pattern": "^N-[0-9]{2}\\.[a-z0-9.-]+$"},
    "input": {
      "oneOf": [
        {
          "title": "merge (from N-09)",
          "allOf": [{"$ref": "#/$defs/envelope"}],
          "properties": {
            "kind": {"const": "merge"},
            "body": {
              "type": "object",
              "required": ["pr", "branch", "merge_sha", "ticket"],
              "properties": {"pr": {"type": "integer"}, "branch": {"type": "string"}, "merge_sha": {"$ref": "#/$defs/sha"}, "ticket": {"type": "string"}}
            }
          }
        },
        {"title": "backup (from N-05), exactly N-05's def", "$ref": "../N-05/record.schema.json#/$defs/backup"},
        {
          "title": "tick (from N-06)",
          "allOf": [{"$ref": "#/$defs/envelope"}],
          "properties": {
            "kind": {"const": "tick"},
            "body": {
              "type": "object",
              "required": ["now", "tick"],
              "properties": {"now": {"$ref": "#/$defs/utc"}, "tick": {"type": "string", "enum": ["daily", "hourly"]}}
            }
          }
        },
        {
          "title": "disposition (from N-49)",
          "allOf": [{"$ref": "#/$defs/envelope"}],
          "properties": {"kind": {"const": "disposition"}, "body": {"$ref": "../N-49/record.schema.json#/$defs/disposition-body"}}
        },
        {
          "title": "branch.delete (from N-50)",
          "allOf": [{"$ref": "#/$defs/envelope"}],
          "properties": {
            "kind": {"const": "branch.delete"},
            "body": {
              "type": "object",
              "required": ["branch", "sha"],
              "properties": {"branch": {"type": "string"}, "sha": {"$ref": "#/$defs/sha"}, "reason": {"type": "string"}}
            }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "required": ["entry", "target", "action", "result"],
      "properties": {
        "entry": {"$ref": "#/$defs/entry-id"},
        "target": {"type": "string", "description": "path or ref"},
        "action": {
          "type": "string",
          "enum": ["rm", "worktree-remove", "branch-delete-remote", "branch-delete-local", "remote-remove", "slot-return", "tag-then-delete"]
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha": {"$ref": "#/$defs/sha", "description": "the sha a deleted ref pointed at"},
        "result": {"type": "string", "enum": ["planned", "deleted", "skipped", "failed"]},
        "reason": {
          "type": "string",
          "enum": ["lease-held", "already-gone", "plan-changed", "lease_not_current", "outside-root", "symlink", "owner-acted", "error"]
        },
        "error": {"type": "string", "maxLength": 240},
        "binding": {"$ref": "#/$defs/binding"},
        "drain": {"$ref": "../../shared/contracts.schema.json#/$defs/lease_ref", "description": "the drain:<resource> lease this row runs under"}
      }
    },
    "output": {
      "title": "cleanup.run",
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "properties": {
        "kind": {"const": "cleanup.run"},
        "code": {"enum": [100, 200, 400, 412, 423]},
        "body": {
          "type": "object",
          "required": ["trigger_record", "phase", "plan_hash", "rows"],
          "properties": {
            "trigger_record": {"type": "string"},
            "trigger_class": {"$ref": "#/$defs/trigger"},
            "phase": {"type": "string", "enum": ["plan", "apply"]},
            "plan_hash": {"$ref": "#/$defs/sha256"},
            "registry_sha": {"$ref": "#/$defs/sha", "description": "main sha the registry was read at"},
            "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
            "failed_entries": {"type": "array", "items": {"$ref": "#/$defs/entry-id"}},
            "owner_acts": {"type": "boolean"},
            "drains": {"type": "array", "items": {"$ref": "../../shared/contracts.schema.json#/$defs/lease_ref"}},
            "reason": {"enum": ["lease_not_current", "plan-changed", "outside-root", "failed-after-3"]}
          }
        },
        "node": {"const": "N-45"}
      }
    },
    "registry-entry": {"$ref": "../../shared/cleanup-registry.schema.json#/$defs/entry"},
    "trigger": {"type": "string", "enum": ["timer", "merge", "backup", "disposition", "owner"]},
    "binding": {
      "type": "object",
      "required": ["dev", "inode", "type"],
      "properties": {
        "dev": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "type": {"enum": ["file", "dir", "worktree", "ref"]},
        "size": {"type": "integer", "minimum": 0},
        "mtime": {"$ref": "#/$defs/utc"}
      },
      "additionalProperties": false,
      "description": "what the plan bound a path to; apply refuses 412 plan-changed on any difference"
    }
  }
}

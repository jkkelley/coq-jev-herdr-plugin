{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-32/record.schema.json",
  "title": "N-32 Bearings page service: input and output records",
  "description": "Input is the frame from N-31 (schema ../N-31/record.schema.json#/$defs/frame). Outputs: page.up, page.state (entity-only), page.down, page.refused, page.bind.failed, file.stored, key.rotated. The owner's acts leave as owner.answer (../N-29/record.schema.json) and owner.message (../N-30/record.schema.json). Envelope per shared/state-store.xml#envelope. Keys, sessions and the /livez body are not records (spec.xml#web-security); livez below is the response shape of GET /livez.",
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "recordId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "page": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "tier": { "enum": ["stable", "uat", "dev"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node"],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string" },
        "code": { "enum": [100, 200, 201, 204, 300, 400, 403, 409, 412, 422, 423, 429, 500, 503] },
        "at": { "$ref": "#/$defs/utc" },
        "node": { "const": "N-32" },
        "seq": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "maxLength": 128 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "epoch": { "type": "integer", "minimum": 1 }
      }
    },
    "tierFields": {
      "type": "object",
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "page": { "$ref": "#/$defs/page" },
        "ticket": { "type": ["string", "null"], "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" }
      },
      "required": ["tier", "page"]
    },
    "livez": {
      "title": "GET /livez response (not a record; no key, no count, no id)",
      "type": "object",
      "additionalProperties": false,
      "required": ["up", "store", "page_state", "at"],
      "properties": {
        "up": { "const": true },
        "store": { "enum": ["up", "down"] },
        "page_state": { "enum": ["live", "stale", "disconnected"] },
        "at": { "$ref": "#/$defs/utc" }
      }
    },
    "page.up": {
      "title": "page.up (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "page.up" },
        "code": { "const": 100 },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "pattern": "^coq-bearings@[a-z0-9-]+\\.service$" },
        "assets_hash": { "$ref": "#/$defs/sha256" },
        "listen_host": { "const": "127.0.0.1" }
      },
      "required": ["port", "pid", "unit", "assets_hash", "listen_host"]
    },
    "page.state": {
      "title": "page.state (entity page:<page>, entity-only per shared/contracts.xml#entity-only: updated every second, a record only when state changes)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "page.state" },
        "code": { "const": 100 },
        "seq_shown": { "type": "integer", "minimum": 0 },
        "store_seq": { "type": "integer", "minimum": 0 },
        "staleness_seconds": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["live", "stale", "disconnected"] },
        "clients": { "type": "integer", "minimum": 0 },
        "cards_open": { "type": "integer", "minimum": 0 },
        "messages_unanswered": { "type": "integer", "minimum": 0 },
        "watcher": { "enum": ["alive", "grace", "dead", "down", "none"] },
        "assets_hash": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "seq_shown",
        "store_seq",
        "staleness_seconds",
        "state",
        "clients",
        "cards_open",
        "messages_unanswered",
        "watcher",
        "assets_hash",
        "version"
      ]
    },
    "page.down": {
      "title": "page.down (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": { "kind": {"const": "page.down"}, "code": {"enum": [100, 500]}, "reason": {"enum": ["stop", "crash", "bind"]} },
      "required": ["reason"]
    },
    "page.refused": {
      "title": "page.refused (output: second instance, 412, exit 4)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "page.refused" },
        "code": { "const": 412 },
        "holder_pid": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer" },
        "exit": { "const": 4, "description": "RestartPreventExitStatus=4 keeps systemd from looping" }
      },
      "required": ["holder_pid", "port"]
    },
    "page.bind.failed": {
      "title": "page.bind.failed (output, alert)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "page.bind.failed" },
        "code": { "const": 500 },
        "port": { "type": "integer" },
        "attempts": { "const": 3 },
        "error": { "type": "string", "maxLength": 240 }
      },
      "required": ["port", "attempts", "error"]
    },
    "file.stored": {
      "title": "file.stored (output)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": {
        "kind": { "const": "file.stored" },
        "code": { "const": 100 },
        "file": { "type": "string", "pattern": "^f-[0-9]{17}-[a-z0-9]{5}$" },
        "path": { "type": "string", "description": "under ${COQ_STATE}/bearings/<page>/files/" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "mime": { "type": "string", "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["file", "path", "bytes", "mime", "sha256"]
    },
    "key.rotated": {
      "title": "key.rotated (output; carries no key)",
      "allOf": [{"$ref": "#/$defs/envelope"}, {"$ref": "#/$defs/tierFields"}],
      "properties": { "kind": {"const": "key.rotated"}, "code": {"const": 100}, "by": {"const": "owner"} },
      "required": ["by"],
      "not": { "required": ["key"] }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/page.up" },
    { "$ref": "#/$defs/page.state" },
    { "$ref": "#/$defs/page.down" },
    { "$ref": "#/$defs/page.refused" },
    { "$ref": "#/$defs/page.bind.failed" },
    { "$ref": "#/$defs/file.stored" },
    { "$ref": "#/$defs/key.rotated" },
    {
      "title": "cutover.imported / cutover.swapped / cutover.refused / cutover.failed (output of cutover.sh, the one-shot unit)",
      "properties": {
        "kind": { "enum": ["cutover.imported", "cutover.swapped", "cutover.refused", "cutover.failed"] },
        "code": { "enum": [100, 201, 412, 500] },
        "legacy_pids": { "type": "array", "maxItems": 8, "items": {"type": "integer", "minimum": 1} },
        "pid": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "assets_hash": { "$ref": "#/$defs/sha256" },
        "step": { "enum": ["a", "b", "c", "d", "e", "f", "g"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "error": { "type": "string", "maxLength": 240 },
        "counts": {
          "type": "object",
          "description": "cutover.imported only: answers, messages, cards imported",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "required": ["tier", "page"],
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/tierFields" },
        {
          "if": { "properties": {"kind": {"const": "cutover.swapped"}} },
          "then": { "properties": {"code": {"const": 201}}, "required": ["legacy_pids", "pid", "port", "assets_hash"] }
        },
        {
          "if": { "properties": {"kind": {"const": "cutover.failed"}} },
          "then": { "properties": {"code": {"const": 500}}, "required": ["step", "attempt", "error"] }
        },
        {
          "if": { "properties": {"kind": {"const": "cutover.refused"}} },
          "then": { "properties": {"code": {"const": 412}}, "required": ["error"] }
        },
        {
          "if": { "properties": {"kind": {"const": "cutover.imported"}} },
          "then": { "properties": {"code": {"const": 100}}, "required": ["counts"] }
        }
      ],
      "not": { "required": ["key"] }
    }
  ]
}

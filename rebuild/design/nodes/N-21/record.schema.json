{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rebuild/design/nodes/N-21/record.schema.json",
 "title": "N-21 Factory namespace: input namespace.manifest and output namespace.ready",
 "description": "Book 1.1.0 (F18, NF-E1, review C new 8 and 10). Envelope: shared/state-store.schema.json#/$defs/envelope (UTC-stamp ids). Values compared with shared/ci-capacity.xml. UTC everywhere.",
 "oneOf": [
  {
   "$ref": "#/$defs/input"
  },
  {
   "$ref": "#/$defs/output"
  },
  {
   "$ref": "#/$defs/unready"
  }
 ],
 "$defs": {
  "envelope": {
   "$ref": "../../shared/state-store.schema.json#/$defs/envelope"
  },
  "sha40": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "input": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "gitops_repo",
      "gitops_sha",
      "manifest_hash",
      "objects",
      "egress_cidrs_hash"
     ],
     "properties": {
      "kind": {
       "const": "namespace.manifest"
      },
      "code": {
       "const": 100
      },
      "node": {
       "const": "N-21"
      },
      "gitops_repo": {
       "const": "jkkelley/homelab-gitops"
      },
      "gitops_sha": {
       "$ref": "#/$defs/sha40"
      },
      "manifest_hash": {
       "$ref": "#/$defs/sha256"
      },
      "objects": {
       "type": "array",
       "minItems": 8,
       "items": {
        "type": "object",
        "required": [
         "kind",
         "name"
        ],
        "properties": {
         "kind": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        }
       }
      },
      "egress_cidrs_hash": {
       "$ref": "#/$defs/sha256"
      }
     }
    }
   ]
  },
  "output": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "gitops_sha",
      "argo_revision",
      "quota",
      "limit_range",
      "priority_class",
      "service_account",
      "policies",
      "pull_secret",
      "canary",
      "check_log"
     ],
     "properties": {
      "kind": {
       "const": "namespace.ready"
      },
      "code": {
       "const": 201
      },
      "node": {
       "const": "N-21"
      },
      "gitops_sha": {
       "$ref": "#/$defs/sha40"
      },
      "argo_revision": {
       "$ref": "#/$defs/sha40"
      },
      "quota": {
       "type": "object",
       "required": [
        "pods",
        "requests.cpu",
        "requests.memory",
        "limits.memory"
       ],
       "properties": {
        "pods": {
         "type": "integer",
         "minimum": 1
        },
        "requests.cpu": {
         "type": "string"
        },
        "requests.memory": {
         "type": "string"
        },
        "limits.memory": {
         "type": "string"
        }
       }
      },
      "limit_range": {
       "type": "object",
       "required": [
        "default_request",
        "default_limit",
        "max"
       ],
       "properties": {
        "default_request": {
         "type": "object"
        },
        "default_limit": {
         "type": "object"
        },
        "max": {
         "type": "object"
        }
       }
      },
      "priority_class": {
       "type": "object",
       "required": [
        "name",
        "value"
       ],
       "properties": {
        "name": {
         "const": "coq-factory-low"
        },
        "value": {
         "type": "integer",
         "maximum": -1
        }
       }
      },
      "service_account": {
       "type": "object",
       "required": [
        "name",
        "automount",
        "can_get_secrets",
        "bindings"
       ],
       "properties": {
        "name": {
         "const": "coq-pod"
        },
        "automount": {
         "const": false
        },
        "can_get_secrets": {
         "const": false
        },
        "bindings": {
         "const": 0
        }
       }
      },
      "policies": {
       "type": "array",
       "minItems": 4,
       "uniqueItems": true,
       "items": {
        "type": "string",
        "enum": [
         "coq-factory-default-deny",
         "coq-factory-egress-dns",
         "coq-factory-egress-github",
         "coq-factory-egress-jenkins"
        ]
       }
      },
      "pull_secret": {
       "type": "object",
       "required": [
        "ready",
        "resource_version"
       ],
       "properties": {
        "ready": {
         "const": true
        },
        "resource_version": {
         "type": "string"
        }
       }
      },
      "canary": {
       "type": "object",
       "required": [
        "dry_run",
        "dns",
        "jenkins_agent",
        "github_fetch",
        "image_pull",
        "example_blocked",
        "duration_s"
       ],
       "properties": {
        "dry_run": {
         "const": "ok"
        },
        "dns": {
         "const": "ok"
        },
        "jenkins_agent": {
         "const": "ok"
        },
        "github_fetch": {
         "const": "ok"
        },
        "image_pull": {
         "const": "ok"
        },
        "example_blocked": {
         "const": "ok"
        },
        "duration_s": {
         "type": "number",
         "minimum": 0,
         "maximum": 180
        }
       }
      },
      "check_log": {
       "type": "string",
       "pattern": "^\\$COQ_STATE/ci/namespace-check/[0-9]{4}/[0-9]{2}/[0-9a-f]{12}-[1-3]\\.log$"
      }
     }
    }
   ]
  },
  "unready": {
   "allOf": [
    {
     "$ref": "#/$defs/envelope"
    },
    {
     "type": "object",
     "required": [
      "gitops_sha",
      "failed",
      "check_log"
     ],
     "properties": {
      "kind": {
       "const": "namespace.unready"
      },
      "code": {
       "const": 500
      },
      "node": {
       "const": "N-21"
      },
      "gitops_sha": {
       "$ref": "#/$defs/sha40"
      },
      "failed": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string"
       }
      },
      "check_log": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}

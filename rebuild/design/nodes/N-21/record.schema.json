{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-21/record.schema.json",
  "title": "N-21 Factory namespace: input namespace.manifest and output namespace.ready",
  "description": "Written 2026-10-14T04:39Z UTC by the G4 spec-author seat. Envelope repeated from N-20 until shared/state-store.schema.json lands.",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/unready" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "attempt", "key", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^r-[0-9]{17}-[a-z0-9]{5}$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "code": { "type": "integer", "enum": [100, 200, 201, 300, 400, 409, 410, 412, 422, 423, 429, 500, 503] },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "key": { "type": "string", "minLength": 3 },
        "version": { "type": "integer", "minimum": 1 },
        "lease_token": { "type": "string" },
        "note": { "type": "string", "maxLength": 240 }
      }
    },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["gitops_repo", "gitops_sha", "manifest_hash", "objects", "egress_cidrs_hash"],
          "properties": {
            "kind": { "const": "namespace.manifest" },
            "code": { "const": 100 },
            "node": { "const": "N-04" },
            "gitops_repo": { "const": "jkkelley/homelab-gitops" },
            "gitops_sha": { "$ref": "#/$defs/sha40" },
            "manifest_hash": { "$ref": "#/$defs/sha256" },
            "objects": {
              "type": "array", "minItems": 8,
              "items": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "type": "string" }, "name": { "type": "string" } } }
            },
            "egress_cidrs_hash": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "output": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["gitops_sha", "argo_revision", "quota", "limit_range", "priority_class", "service_account", "policies", "pull_secret", "canary", "check_log"],
          "properties": {
            "kind": { "const": "namespace.ready" },
            "code": { "const": 201 },
            "node": { "const": "N-21" },
            "gitops_sha": { "$ref": "#/$defs/sha40" },
            "argo_revision": { "$ref": "#/$defs/sha40" },
            "quota": {
              "type": "object", "required": ["pods", "requests.cpu", "requests.memory", "limits.memory"],
              "properties": { "pods": { "type": "integer", "minimum": 1 }, "requests.cpu": { "type": "string" }, "requests.memory": { "type": "string" }, "limits.memory": { "type": "string" } }
            },
            "limit_range": {
              "type": "object", "required": ["default_request", "default_limit", "max"],
              "properties": { "default_request": { "type": "object" }, "default_limit": { "type": "object" }, "max": { "type": "object" } }
            },
            "priority_class": { "type": "object", "required": ["name", "value"], "properties": { "name": { "const": "coq-factory-low" }, "value": { "type": "integer", "maximum": -1 } } },
            "service_account": {
              "type": "object", "required": ["name", "automount", "can_get_secrets", "bindings"],
              "properties": { "name": { "const": "coq-pod" }, "automount": { "const": false }, "can_get_secrets": { "const": false }, "bindings": { "const": 0 } }
            },
            "policies": {
              "type": "array", "minItems": 4, "uniqueItems": true,
              "items": { "type": "string", "enum": ["coq-factory-default-deny", "coq-factory-egress-dns", "coq-factory-egress-github", "coq-factory-egress-jenkins"] }
            },
            "pull_secret": { "type": "object", "required": ["ready", "resource_version"], "properties": { "ready": { "const": true }, "resource_version": { "type": "string" } } },
            "canary": {
              "type": "object", "required": ["github_fetch", "example_blocked", "duration_s"],
              "properties": { "github_fetch": { "const": "ok" }, "example_blocked": { "const": "ok" }, "duration_s": { "type": "number", "minimum": 0, "maximum": 180 } }
            },
            "check_log": { "type": "string", "pattern": "^\\$COQ_STATE/ci/namespace-check/[0-9]{4}/[0-9]{2}/[0-9a-f]{12}-[0-3]\\.log$" }
          }
        }
      ]
    },
    "unready": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["gitops_sha", "failed", "check_log"],
          "properties": {
            "kind": { "const": "namespace.unready" },
            "code": { "const": 500 },
            "node": { "const": "N-21" },
            "attempt": { "const": 3 },
            "gitops_sha": { "$ref": "#/$defs/sha40" },
            "failed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "check_log": { "type": "string" }
          }
        }
      ]
    }
  }
}

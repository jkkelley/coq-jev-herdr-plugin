{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-02/record.schema.json",
  "title": "N-02 Lease service records",
  "description": "Book 1.1.0. Calls lease_start, lease_renew, lease_release, lease_acquire, lease_revoke; records lease.granted (node N-02, by N-07 inside GrantDispatch), lease.released, lease.expired, lease.refused, lease.stale, lease.recovered, lease.failed of node N-02. The lease itself is shared/contracts.schema.json#/$defs/lease_row and the key, class, state and reference are the shared defs; nothing here restates them (shared/contracts.xml#lease-machine). Input ticket.ready is ../N-03/record.schema.json#/$defs/ticket_ready. Tokens are integers. Parent volume: spec.xml#N-02. UTC everywhere.",
  "$defs": {
    "envelope": {
      "$ref": "../N-01/record.schema.json#/$defs/envelope"
    },
    "at": {
      "$ref": "../N-01/record.schema.json#/$defs/at"
    },
    "id": {
      "$ref": "../N-01/record.schema.json#/$defs/id"
    },
    "ticket": {
      "$ref": "../../shared/contracts.schema.json#/$defs/ticket"
    },
    "phase": {
      "$ref": "../../shared/contracts.schema.json#/$defs/phase"
    },
    "role": {
      "$ref": "../../shared/contracts.schema.json#/$defs/role"
    },
    "lease_key": {
      "$ref": "../../shared/contracts.schema.json#/$defs/lease_key"
    },
    "lease_class": {
      "$ref": "../../shared/contracts.schema.json#/$defs/lease_class"
    },
    "lease_state": {
      "$ref": "../../shared/contracts.schema.json#/$defs/lease_state"
    },
    "lease_ref": {
      "$ref": "../../shared/contracts.schema.json#/$defs/lease_ref"
    },
    "lease_row": {
      "$ref": "../../shared/contracts.schema.json#/$defs/lease_row"
    },
    "token": {
      "$ref": "../../shared/state-store.schema.json#/$defs/lease_token"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "the launcher run id (N-15)"
    },
    "lease_body": {
      "description": "kept for the citations that name it: the lease row as a record body carries it",
      "$ref": "#/$defs/lease_row"
    },
    "ticket_ready": {
      "$ref": "../N-03/record.schema.json#/$defs/ticket_ready"
    },
    "lease_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "token",
        "run_id",
        "at"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/lease_key"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "at": {
          "$ref": "#/$defs/at"
        }
      },
      "description": "leases.start; no lease record is written, run:RUN_ID moves in the same Commit; run_id equals the dispatch id"
    },
    "lease_renew": {
      "description": "Renew requires the generation (NF-A2); a renew of a lease that is not running, not current or expired is 412",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "token",
        "generation",
        "at"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/lease_key"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "progress_at": {
          "$ref": "#/$defs/at"
        },
        "at": {
          "$ref": "#/$defs/at"
        }
      }
    },
    "lease_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "token",
        "result"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/lease_key"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "result": {
          "$ref": "#/$defs/id",
          "description": "the seat.result, merge or job record that ends the holder's work"
        }
      }
    },
    "lease_acquire": {
      "description": "a system class lease (work or maintenance); seat leases are granted only inside GrantDispatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "class",
        "holder"
      ],
      "properties": {
        "key": {
          "$ref": "../../shared/contracts.schema.json#/$defs/system_lease_key"
        },
        "class": {
          "enum": [
            "work",
            "maintenance"
          ]
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lease_revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "judged_version",
        "end_reason",
        "stall"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/lease_key"
        },
        "judged_version": {
          "type": "integer",
          "minimum": 1,
          "description": "the row version N-12 read when it judged the stall"
        },
        "end_reason": {
          "enum": [
            "revoked-stall",
            "revoked-launcher-lost",
            "revoked-ruling"
          ]
        },
        "stall": {
          "$ref": "#/$defs/id",
          "description": "N-12's stall record id"
        }
      },
      "description": "N-12 runs leases.revoke inside its own Commit and appends its stall record there; no lease record is written (shared/contracts.xml#statements)"
    },
    "n02_record": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "const": "N-02"
            }
          }
        }
      ]
    },
    "lease_granted": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "$ref": "#/$defs/lease_row"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "lease.granted"
            },
            "code": {
              "const": 201
            },
            "state": {
              "enum": [
                "reserved",
                "running"
              ]
            },
            "role": {
              "$ref": "#/$defs/role"
            },
            "regrant_of": {
              "enum": [
                "claim_overlap",
                "cap"
              ],
              "description": "present on a free regrant of a terminal key"
            },
            "by": {
              "enum": [
                "N-02",
                "N-07",
                "N-05",
                "N-09",
                "N-27",
                "N-45"
              ],
              "description": "the caller N-01 derived: N-07 for a seat grant inside GrantDispatch, the job's node for an acquire"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "class": {
                    "const": "seat"
                  }
                }
              },
              "then": {
                "properties": {
                  "state": {
                    "const": "reserved"
                  }
                }
              },
              "else": {
                "properties": {
                  "state": {
                    "const": "running"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "lease_refused": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "key",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "lease.refused"
            },
            "code": {
              "enum": [
                423,
                429
              ]
            },
            "key": {
              "$ref": "#/$defs/lease_key"
            },
            "reason": {
              "enum": [
                "held",
                "cap",
                "hold"
              ]
            },
            "holder": {
              "type": "string",
              "minLength": 1
            },
            "expires_at": {
              "$ref": "#/$defs/at"
            },
            "cap": {
              "type": "integer",
              "minimum": 0
            },
            "live": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "reason": {
                    "const": "cap"
                  }
                }
              },
              "then": {
                "properties": {
                  "code": {
                    "const": 429
                  }
                }
              },
              "else": {
                "properties": {
                  "code": {
                    "const": 423
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "lease_expired": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "key",
            "class",
            "holder",
            "token",
            "generation",
            "expires_at",
            "end_reason"
          ],
          "properties": {
            "kind": {
              "const": "lease.expired"
            },
            "code": {
              "const": 500
            },
            "key": {
              "$ref": "#/$defs/lease_key"
            },
            "class": {
              "$ref": "#/$defs/lease_class"
            },
            "holder": {
              "type": "string",
              "minLength": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "generation": {
              "$ref": "#/$defs/generation"
            },
            "heartbeat_at": {
              "$ref": "#/$defs/at"
            },
            "expires_at": {
              "$ref": "#/$defs/at"
            },
            "end_reason": {
              "enum": [
                "expired",
                "start-grace"
              ],
              "description": "start-grace: a reserved lease never started; no attempt is charged"
            },
            "release_tried_by": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "lease_stale": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "key",
            "token_seen",
            "op",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "lease.stale"
            },
            "code": {
              "const": 412
            },
            "key": {
              "$ref": "#/$defs/lease_key"
            },
            "token_seen": {
              "$ref": "#/$defs/token"
            },
            "token_current": {
              "$ref": "#/$defs/token"
            },
            "generation_seen": {
              "$ref": "#/$defs/generation"
            },
            "op": {
              "enum": [
                "start",
                "renew",
                "release"
              ]
            },
            "reason": {
              "enum": [
                "stale_token",
                "lease_not_current"
              ]
            },
            "state": {
              "$ref": "#/$defs/lease_state"
            }
          }
        }
      ]
    },
    "lease_recovered": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "swept",
            "kept"
          ],
          "properties": {
            "kind": {
              "const": "lease.recovered"
            },
            "code": {
              "const": 100
            },
            "swept": {
              "type": "integer",
              "minimum": 0
            },
            "kept": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "lease_failed": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "key",
            "reason",
            "attempts"
          ],
          "properties": {
            "kind": {
              "const": "lease.failed"
            },
            "code": {
              "const": 500
            },
            "key": {
              "$ref": "#/$defs/lease_key"
            },
            "reason": {
              "type": "string",
              "maxLength": 240
            },
            "attempts": {
              "const": 3
            }
          }
        }
      ]
    },
    "lease_released": {
      "allOf": [
        {
          "$ref": "#/$defs/n02_record"
        },
        {
          "type": "object",
          "required": [
            "key",
            "token",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "lease.released"
            },
            "code": {
              "const": 204
            },
            "key": {
              "$ref": "#/$defs/lease_key"
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "state": {
              "const": "released"
            },
            "result": {
              "$ref": "#/$defs/id",
              "description": "the seat.result, merge or job record that ended the work"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/lease_start"
    },
    {
      "$ref": "#/$defs/lease_renew"
    },
    {
      "$ref": "#/$defs/lease_release"
    },
    {
      "$ref": "#/$defs/lease_acquire"
    },
    {
      "$ref": "#/$defs/lease_revoke"
    },
    {
      "$ref": "#/$defs/lease_granted"
    },
    {
      "$ref": "#/$defs/lease_released"
    },
    {
      "$ref": "#/$defs/lease_refused"
    },
    {
      "$ref": "#/$defs/lease_expired"
    },
    {
      "$ref": "#/$defs/lease_stale"
    },
    {
      "$ref": "#/$defs/lease_recovered"
    },
    {
      "$ref": "#/$defs/lease_failed"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-06/record.schema.json",
  "title": "N-06 Service unit, clock and health records",
  "description": "Book 1.1.0. Input unit.start of the two system units coq-svc.service and coq-launch.service (shared/authority.xml#principals); output tick (entity-only kind: entity tick:SUBKIND and the in-process broadcast, shared/contracts.xml#entity-only), health (entity-only: entity health:service), and the log records unit.started, tick.daily, tick.missed, health.unhealthy, health.recovered, unit.crashloop, unit.duplicate (exit 4), reload.applied, reload.failed and host.outage (imported from the outside probe's journal, shared/outside-probe.xml#journal) of node N-06. $defs/tick keeps its name and shape: N-04, N-05, N-07 and N-12 reference it. Parent volume: spec.xml#N-06. UTC everywhere.",
  "$defs": {
    "envelope": {
      "$ref": "../N-01/record.schema.json#/$defs/envelope"
    },
    "at": {
      "$ref": "../N-01/record.schema.json#/$defs/at"
    },
    "sha256": {
      "$ref": "../N-01/record.schema.json#/$defs/sha256"
    },
    "subkind": {
      "enum": [
        "scheduler",
        "poll",
        "backup",
        "stall",
        "daily",
        "health"
      ]
    },
    "unit_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "reason",
        "at",
        "env"
      ],
      "properties": {
        "unit": {
          "enum": [
            "coq-svc.service",
            "coq-launch.service"
          ]
        },
        "reason": {
          "enum": [
            "boot",
            "restart",
            "manual",
            "watchdog"
          ]
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "env": {
          "type": "object",
          "required": [
            "COQ_STATE",
            "COQ_REPO"
          ],
          "properties": {
            "COQ_STATE": {
              "type": "string",
              "pattern": "^/"
            },
            "COQ_REPO": {
              "type": "string",
              "pattern": "^/"
            },
            "SECRETS_FILE": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subkind",
        "at",
        "n",
        "start_id",
        "interval_seconds"
      ],
      "properties": {
        "subkind": {
          "$ref": "#/$defs/subkind"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "description": "per-subkind counter since start"
        },
        "start_id": {
          "$ref": "../N-01/record.schema.json#/$defs/id",
          "description": "the unit.started record this counter belongs to"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "class": {
          "enum": [
            "tick",
            "daily",
            "monthly"
          ],
          "description": "backup subkind only: the retention class N-05 records"
        },
        "late_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ok"
      ],
      "properties": {
        "name": {
          "enum": [
            "store",
            "forge",
            "backup",
            "leases",
            "ticks",
            "disk",
            "unit",
            "launcher"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 240
        },
        "age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "owner_acts": {
          "type": "boolean",
          "description": "true when the shared status map says the owner acts on this reason"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "at",
        "checks",
        "counters",
        "unit"
      ],
      "properties": {
        "status": {
          "enum": [
            "serving",
            "not_serving"
          ]
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "checks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "unit": {
          "type": "object",
          "required": [
            "pid",
            "started_at",
            "version",
            "config_hash",
            "hold"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "started_at": {
              "$ref": "#/$defs/at"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "config_hash": {
              "$ref": "#/$defs/sha256"
            },
            "hold": {
              "type": "boolean"
            },
            "build_mode": {
              "type": "boolean"
            },
            "launcher_pid": {
              "type": "integer",
              "minimum": 1
            },
            "seats_running": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "unit_started": {
      "allOf": [
        {
          "$ref": "#/$defs/n06_record"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "reason",
            "version",
            "config_hash",
            "state_root",
            "store_status"
          ],
          "properties": {
            "kind": {
              "const": "unit.started"
            },
            "code": {
              "const": 100
            },
            "node": {
              "const": "N-06"
            },
            "reason": {
              "enum": [
                "boot",
                "restart",
                "manual",
                "watchdog"
              ]
            },
            "version": {
              "type": "string"
            },
            "config_hash": {
              "$ref": "#/$defs/sha256"
            },
            "state_root": {
              "type": "string",
              "pattern": "^/"
            },
            "store_status": {
              "enum": [
                "serving",
                "not_serving"
              ]
            },
            "unit": {
              "enum": [
                "coq-svc.service",
                "coq-launch.service"
              ]
            },
            "seats_adopted": {
              "type": "integer",
              "minimum": 0,
              "description": "coq-launch only: coq-seat-* units adopted by run entity at start"
            }
          }
        }
      ]
    },
    "tick_log": {
      "allOf": [
        {
          "$ref": "#/$defs/n06_record"
        },
        {
          "type": "object",
          "required": [
            "subkind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "tick.daily",
                "tick.missed"
              ]
            },
            "code": {
              "enum": [
                100,
                500
              ]
            },
            "node": {
              "const": "N-06"
            },
            "subkind": {
              "$ref": "#/$defs/subkind"
            },
            "late_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "health_transition": {
      "allOf": [
        {
          "$ref": "#/$defs/n06_record"
        },
        {
          "type": "object",
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "kind": {
              "enum": [
                "health.unhealthy",
                "health.recovered"
              ]
            },
            "code": {
              "enum": [
                200,
                503
              ]
            },
            "node": {
              "const": "N-06"
            },
            "status": {
              "enum": [
                "serving",
                "not_serving"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 240
              }
            },
            "owner_acts": {
              "type": "boolean"
            },
            "since": {
              "$ref": "#/$defs/at"
            }
          }
        }
      ]
    },
    "unit_report": {
      "allOf": [
        {
          "$ref": "#/$defs/n06_record"
        },
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unit.crashloop",
                "unit.duplicate",
                "reload.applied",
                "reload.failed"
              ]
            },
            "code": {
              "enum": [
                200,
                500
              ]
            },
            "node": {
              "const": "N-06"
            },
            "reason": {
              "type": "string",
              "maxLength": 240
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "restarts": {
              "type": "integer",
              "minimum": 0
            },
            "window_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "hashes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              }
            },
            "key": {
              "type": "string",
              "description": "reload.failed: the config key that failed validation"
            },
            "exit_status": {
              "enum": [
                3,
                4
              ],
              "description": "3 a missing config key, 4 a duplicate instance (RestartPreventExitStatus=4)"
            },
            "unit": {
              "enum": [
                "coq-svc.service",
                "coq-launch.service"
              ]
            }
          }
        }
      ]
    },
    "n06_record": {
      "description": "envelope plus node N-06 and the store epoch",
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "const": "N-06"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "host_outage": {
      "description": "500: an outage the outside probe saw while the store could not take records, imported once per outage_id on recovery (operation key N-06/host.outage/<outage_id>/r1)",
      "allOf": [
        {
          "$ref": "#/$defs/n06_record"
        },
        {
          "type": "object",
          "required": [
            "outage_id",
            "state",
            "started_at",
            "ended_at"
          ],
          "properties": {
            "kind": {
              "const": "host.outage"
            },
            "code": {
              "const": 500
            },
            "outage_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "the probe's outage id, as journaled"
            },
            "state": {
              "enum": [
                "host-down",
                "store-down",
                "page-down"
              ]
            },
            "started_at": {
              "$ref": "#/$defs/at"
            },
            "ended_at": {
              "$ref": "#/$defs/at"
            },
            "passes_failed": {
              "type": "integer",
              "minimum": 0
            },
            "alerts_sent": {
              "type": "integer",
              "minimum": 0
            },
            "last_error": {
              "type": "string",
              "maxLength": 240
            },
            "alert_failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/unit_start"
    },
    {
      "$ref": "#/$defs/tick"
    },
    {
      "$ref": "#/$defs/health"
    },
    {
      "$ref": "#/$defs/unit_started"
    },
    {
      "$ref": "#/$defs/tick_log"
    },
    {
      "$ref": "#/$defs/health_transition"
    },
    {
      "$ref": "#/$defs/unit_report"
    },
    {
      "$ref": "#/$defs/host_outage"
    }
  ]
}

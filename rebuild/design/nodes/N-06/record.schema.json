{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coq/rebuild/design/nodes/N-06/record.schema.json",
  "title": "N-06 Service unit, clock and health records",
  "description": "Input unit.start; output tick (entity tick:SUBKIND and the in-process broadcast), health (entity health:service), and the log records unit.started, tick.daily, tick.missed, health.unhealthy, health.recovered, unit.crashloop, unit.duplicate, reload.applied, reload.failed of node N-06. Parent volume: spec.xml#N-06. UTC everywhere.",
  "$defs": {
    "envelope": { "$ref": "../N-01/record.schema.json#/$defs/envelope" },
    "at": { "$ref": "../N-01/record.schema.json#/$defs/at" },
    "sha256": { "$ref": "../N-01/record.schema.json#/$defs/sha256" },
    "subkind": {
      "enum": ["scheduler", "poll", "backup", "stall", "daily", "health"]
    },
    "unit_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "reason", "at", "env"],
      "properties": {
        "unit": { "const": "coq-service.service" },
        "reason": { "enum": ["boot", "restart", "manual", "watchdog"] },
        "at": { "$ref": "#/$defs/at" },
        "env": {
          "type": "object",
          "required": ["COQ_STATE", "COQ_REPO", "XDG_RUNTIME_DIR"],
          "properties": {
            "COQ_STATE": { "type": "string", "pattern": "^/" },
            "COQ_REPO": { "type": "string", "pattern": "^/" },
            "XDG_RUNTIME_DIR": { "type": "string", "pattern": "^/" }
          },
          "additionalProperties": false
        }
      }
    },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subkind", "at", "n", "start_id", "interval_seconds"],
      "properties": {
        "subkind": { "$ref": "#/$defs/subkind" },
        "at": { "$ref": "#/$defs/at" },
        "n": {
          "type": "integer",
          "minimum": 1,
          "description": "per-subkind counter since start"
        },
        "start_id": {
          "$ref": "../N-01/record.schema.json#/$defs/id",
          "description": "the unit.started record this counter belongs to"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "class": {
          "enum": ["tick", "daily", "monthly"],
          "description": "backup subkind only: the retention class N-05 records"
        },
        "late_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok"],
      "properties": {
        "name": {
          "enum": [
            "store",
            "forge",
            "backup",
            "leases",
            "ticks",
            "disk",
            "unit"
          ]
        },
        "ok": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 240 },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "owner_acts": {
          "type": "boolean",
          "description": "true when the shared status map says the owner acts on this reason"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "at", "checks", "counters", "unit"],
      "properties": {
        "status": { "enum": ["serving", "not_serving"] },
        "at": { "$ref": "#/$defs/at" },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/check" }
        },
        "counters": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "unit": {
          "type": "object",
          "required": ["pid", "started_at", "version", "config_hash", "hold"],
          "properties": {
            "pid": { "type": "integer", "minimum": 1 },
            "started_at": { "$ref": "#/$defs/at" },
            "version": { "type": "string", "minLength": 1 },
            "config_hash": { "$ref": "#/$defs/sha256" },
            "hold": { "type": "boolean" },
            "build_mode": { "type": "boolean" }
          }
        }
      }
    },
    "unit_started": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "reason",
            "version",
            "config_hash",
            "state_root",
            "store_status"
          ],
          "properties": {
            "kind": { "const": "unit.started" },
            "code": { "const": 100 },
            "node": { "const": "N-06" },
            "reason": { "enum": ["boot", "restart", "manual", "watchdog"] },
            "version": { "type": "string" },
            "config_hash": { "$ref": "#/$defs/sha256" },
            "state_root": { "type": "string", "pattern": "^/" },
            "store_status": { "enum": ["serving", "not_serving"] }
          }
        }
      ]
    },
    "tick_log": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["subkind"],
          "properties": {
            "kind": { "enum": ["tick.daily", "tick.missed"] },
            "code": { "enum": [100, 500] },
            "node": { "const": "N-06" },
            "subkind": { "$ref": "#/$defs/subkind" },
            "late_seconds": { "type": "integer", "minimum": 0 },
            "n": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "health_transition": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "kind": { "enum": ["health.unhealthy", "health.recovered"] },
            "code": { "enum": [200, 503] },
            "node": { "const": "N-06" },
            "status": { "enum": ["serving", "not_serving"] },
            "reasons": {
              "type": "array",
              "items": { "type": "string", "maxLength": 240 }
            },
            "owner_acts": { "type": "boolean" },
            "since": { "$ref": "#/$defs/at" }
          }
        }
      ]
    },
    "unit_report": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "kind": {
              "enum": [
                "unit.crashloop",
                "unit.duplicate",
                "reload.applied",
                "reload.failed"
              ]
            },
            "code": { "enum": [200, 500] },
            "node": { "const": "N-06" },
            "reason": { "type": "string", "maxLength": 240 },
            "pid": { "type": "integer", "minimum": 1 },
            "restarts": { "type": "integer", "minimum": 0 },
            "window_seconds": { "type": "integer", "minimum": 0 },
            "hashes": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/sha256" }
            },
            "key": {
              "type": "string",
              "description": "reload.failed: the config key that failed validation"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/unit_start" },
    { "$ref": "#/$defs/tick" },
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/unit_started" },
    { "$ref": "#/$defs/tick_log" },
    { "$ref": "#/$defs/health_transition" },
    { "$ref": "#/$defs/unit_report" }
  ]
}

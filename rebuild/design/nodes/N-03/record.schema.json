{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-03/record.schema.json",
  "title": "N-03 Ticket intake and readiness records",
  "description": "Input ticket; output ticket.ready, ticket.waiting, ticket.refused, ticket.admitted, ticket.done, ticket.cancelled, ticket.transition_refused, ticket.stale, intake.recovered, intake.failed, intake.orphan, intake.slow of node N-03. Parent volume: spec.xml#N-03. UTC everywhere.",
  "$defs": {
    "envelope": {
      "$ref": "../N-01/record.schema.json#/$defs/envelope"
    },
    "at": {
      "$ref": "../N-01/record.schema.json#/$defs/at"
    },
    "id": {
      "$ref": "../N-01/record.schema.json#/$defs/id"
    },
    "ticket_id": {
      "$ref": "../N-01/record.schema.json#/$defs/ticket"
    },
    "phase": {
      "enum": [
        "worker",
        "reviewer",
        "merge",
        "spec"
      ]
    },
    "status": {
      "enum": [
        "cut",
        "waiting",
        "ready",
        "in_flight",
        "done",
        "dead",
        "cancelled",
        "refused"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\s]+$"
    },
    "acceptance_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "observed_on_main": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "what N-18 observed on main before the cut was allowed"
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "files",
        "deps",
        "role",
        "acceptance",
        "input",
        "output",
        "priority",
        "cut_by",
        "cut_at",
        "design_anchor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ticket_id"
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "deps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/ticket_id"
          }
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/acceptance_command"
          }
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "the record or state that starts the ticket"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "the record or state that ends it"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "cut_by": {
          "enum": [
            "N-18",
            "N-29",
            "N-30",
            "N-49",
            "N-10"
          ]
        },
        "cut_at": {
          "$ref": "#/$defs/at"
        },
        "design_anchor": {
          "type": "string",
          "pattern": "^rebuild/design/[A-Za-z0-9/_.-]+\\.xml#[A-Za-z0-9_.-]+$",
          "description": "the DAG node volume and anchor the ticket is cut from"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1
        },
        "body": {
          "type": "string",
          "maxLength": 8000,
          "description": "the brief text a seat reads; markdown"
        }
      }
    },
    "ticket_ready": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "phase",
            "attempt",
            "role",
            "claims",
            "brief_inputs"
          ],
          "properties": {
            "kind": {
              "const": "ticket.ready"
            },
            "code": {
              "const": 200
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "phase": {
              "$ref": "#/$defs/phase"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "role": {
              "type": "string"
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "brief_inputs": {
              "type": "object",
              "required": [
                "entity_key",
                "design_anchor"
              ],
              "properties": {
                "entity_key": {
                  "type": "string",
                  "pattern": "^ticket:(WO-[0-9]{8}-[0-9a-f]{4}|CR-[a-z0-9._-]+)$"
                },
                "design_anchor": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "ticket_waiting": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "ticket.waiting"
            },
            "code": {
              "const": 100
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "reason": {
              "enum": [
                "deps",
                "files",
                "hold",
                "validation"
              ]
            },
            "deps_pending": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ticket_id"
              }
            },
            "files_held": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "holder"
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/path"
                  },
                  "holder": {
                    "$ref": "#/$defs/ticket_id"
                  }
                }
              }
            },
            "path": {
              "type": "string",
              "description": "validation only: the failing JSON pointer"
            }
          }
        }
      ]
    },
    "ticket_refused": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "ticket.refused"
            },
            "code": {
              "const": 422
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "reason": {
              "enum": [
                "cycle",
                "unknown_dep",
                "empty_files",
                "aggregate_file",
                "schema"
              ]
            },
            "detail": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      ]
    },
    "ticket_terminal": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "by",
            "claims_released"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ticket.done",
                "ticket.cancelled"
              ]
            },
            "code": {
              "const": 204
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "the merge, ruling or cut-over record"
            },
            "claims_released": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "ticket_admitted": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "ticket.admitted"
            },
            "code": {
              "const": 100
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "status": {
              "$ref": "#/$defs/status"
            }
          }
        }
      ]
    },
    "ticket_transition_refused": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "from",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "ticket.transition_refused"
            },
            "code": {
              "const": 409
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "from": {
              "$ref": "#/$defs/status"
            },
            "to": {
              "$ref": "#/$defs/status"
            }
          }
        }
      ]
    },
    "ticket_stale": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "ticket",
            "waiting_since",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "ticket.stale"
            },
            "code": {
              "const": 500
            },
            "node": {
              "const": "N-03"
            },
            "ticket": {
              "$ref": "#/$defs/ticket_id"
            },
            "waiting_since": {
              "$ref": "#/$defs/at"
            },
            "reason": {
              "enum": [
                "deps",
                "files",
                "hold"
              ]
            }
          }
        }
      ]
    },
    "intake_report": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "intake.recovered",
                "intake.failed",
                "intake.orphan",
                "intake.slow"
              ]
            },
            "code": {
              "enum": [
                100,
                500
              ]
            },
            "node": {
              "const": "N-03"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "pr": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      ]
    },
    "ticket_request": {
      "description": "A request to cut tickets, admitted by N-03 as a cut request CR-<id> at phase spec (nodes/N-03/spec.xml#input); writers N-10, N-30, N-49, N-50",
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "request_id",
            "source",
            "title",
            "brief"
          ],
          "properties": {
            "kind": {
              "const": "ticket.request"
            },
            "code": {
              "const": 100
            },
            "request_id": {
              "type": "string",
              "pattern": "^[a-z0-9._-]+$",
              "description": "idempotency key: one per message id, LAND row, fix-<hold_id>-<n> or cancel set"
            },
            "source": {
              "type": "string",
              "description": "the id of the record that caused the request"
            },
            "anchor": {
              "type": "string",
              "description": "the design anchor or 04-UNLANDED row it is about"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "brief": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "acceptance": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/acceptance_command"
              }
            },
            "hold_id": {
              "type": "string"
            },
            "rejected_id": {
              "type": "string"
            },
            "lane": {
              "enum": [
                "rebuild",
                "product"
              ]
            },
            "priority": {
              "type": "integer"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ticket"
    },
    {
      "$ref": "#/$defs/ticket_ready"
    },
    {
      "$ref": "#/$defs/ticket_waiting"
    },
    {
      "$ref": "#/$defs/ticket_refused"
    },
    {
      "$ref": "#/$defs/ticket_terminal"
    },
    {
      "$ref": "#/$defs/ticket_admitted"
    },
    {
      "$ref": "#/$defs/ticket_transition_refused"
    },
    {
      "$ref": "#/$defs/ticket_stale"
    },
    {
      "$ref": "#/$defs/intake_report"
    }
  ]
}

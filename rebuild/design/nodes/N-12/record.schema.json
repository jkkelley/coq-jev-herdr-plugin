{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coq.factory/rebuild/design/nodes/N-12/record.schema.json",
  "title": "N-12 Stall timer: input and output records",
  "description": "Inputs lease.granted and lease.expired (../N-02/record.schema.json), seat.heartbeat (../N-15/record.schema.json#/$defs/seat.heartbeat) and the tick:stall entity (../N-06/record.schema.json#/$defs/tick), none repeated here; outputs stall and stall.kill.failed. Base shape as in ../N-07/record.schema.json#/$defs/base. Times are UTC. Written 2026-10-14 UTC by the G2 spec-author seat.",
  "oneOf": [
    { "$ref": "../N-02/record.schema.json#/$defs/lease_granted" },
    { "$ref": "../N-02/record.schema.json#/$defs/lease_expired" },
    { "$ref": "../N-15/record.schema.json#/$defs/seat.heartbeat" },
    { "$ref": "../N-06/record.schema.json#/$defs/tick" },
    { "$ref": "#/$defs/stall" },
    { "$ref": "#/$defs/stall_kill_failed" }
  ],
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "phase": { "$ref": "../N-07/record.schema.json#/$defs/phase" },
    "role": { "$ref": "../N-07/record.schema.json#/$defs/role" },
    "base": { "$ref": "../N-07/record.schema.json#/$defs/base" },
    "stall": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "stall" },
        "code": { "const": 500 },
        "node": { "const": "N-12" },
        "idempotency_key": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}:[a-z-]+:[1-3]:[0-9]+$", "description": "the lease key (ticket:phase:attempt), colon, the generation written by the revoke" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "phase": { "$ref": "#/$defs/phase" },
        "role": { "$ref": "#/$defs/role" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "dispatch_id": { "type": "string" },
        "run_id": { "type": "string" },
        "lease_key": { "type": "string" },
        "old_token": { "type": "integer", "minimum": 1 },
        "new_generation": { "type": "integer", "minimum": 2 },
        "reason": { "type": "string", "enum": ["no-progress", "launcher-dead", "deadline", "no-first-heartbeat", "lease-expired"] },
        "outcome": { "const": "stalled" },
        "last_heartbeat_at": { "$ref": "#/$defs/at" },
        "last_progress_at": { "$ref": "#/$defs/at" },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "bound_seconds": { "type": "integer", "minimum": 1 },
        "deadline": { "$ref": "#/$defs/at" },
        "pid": { "type": "integer", "minimum": 0 },
        "killed": { "type": "boolean" },
        "kill_reason": { "type": "string", "enum": ["term", "kill", "already-gone", "pid-reused"] },
        "kill_attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "handled_by": { "type": "string", "description": "set by N-11" },
        "handled_generation": { "type": "integer" }
      },
      "required": ["idempotency_key", "ticket", "phase", "role", "attempt", "dispatch_id", "run_id", "lease_key", "old_token", "new_generation", "reason", "outcome", "age_seconds", "bound_seconds", "killed", "kill_attempts"]
    },
    "stall_kill_failed": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "stall.kill.failed" },
        "code": { "const": 500 },
        "node": { "const": "N-12" },
        "idempotency_key": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}:[a-z-]+:[1-3]:[0-9]+:kill-failed$" },
        "lease_key": { "type": "string" },
        "run_id": { "type": "string" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "pid": { "type": "integer", "minimum": 1 },
        "process_start": { "$ref": "#/$defs/at" },
        "attempts": { "const": 3 },
        "owner_acts": { "const": true }
      },
      "required": ["idempotency_key", "lease_key", "run_id", "ticket", "pid", "attempts", "owner_acts"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-23/record.schema.json",
  "title": "N-23 Suite planner: input pr.opened and output suite.plan",
  "description": "Written 2026-10-14T04:39Z UTC by the G4 spec-author seat. Envelope repeated from N-20 until shared/state-store.schema.json lands. N-26 reuses $defs/output with kind main.plan.",
  "oneOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/refused" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "code", "at", "node", "attempt", "key", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^r-[0-9]{17}-[a-z0-9]{5}$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "code": { "type": "integer", "enum": [100, 200, 201, 300, 400, 409, 410, 412, 422, 423, 429, 500, 503] },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "node": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "key": { "type": "string", "minLength": 3 },
        "version": { "type": "integer", "minimum": 1 },
        "lease_token": { "type": "string" },
        "note": { "type": "string", "maxLength": 240 }
      }
    },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "required": ["name", "suite", "image", "workdir", "cmd", "budget_minutes", "kind", "skip"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+(:[A-Za-z0-9._-]+)?$", "description": "suite or suite:case" },
        "suite": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "image": {
          "type": "object", "required": ["name", "digest"],
          "properties": { "name": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } }
        },
        "workdir": { "type": "string", "pattern": "^/repo(/.*)?$" },
        "cmd": { "type": "string", "minLength": 1, "not": { "pattern": "(^| )make lint( |$)" } },
        "budget_minutes": { "type": "integer", "minimum": 5, "maximum": 30 },
        "budget_source": { "type": "string", "enum": ["suite.budget", "tests.json", "default"] },
        "kind": { "type": "string", "enum": ["pod", "spec-check"] },
        "skip": { "const": false }
      }
    },
    "input": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["repo", "pr", "head_sha", "base_ref", "head_repo", "source"],
          "properties": {
            "kind": { "const": "pr.opened" },
            "code": { "const": 100 },
            "node": { "enum": ["N-16", "N-07"] },
            "repo": { "const": "jkkelley/coq-jev-herdr-plugin" },
            "pr": { "type": "integer", "minimum": 1 },
            "head_sha": { "$ref": "#/$defs/sha40" },
            "base_ref": { "const": "main" },
            "head_repo": { "type": "string" },
            "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
            "source": { "type": "string", "enum": ["seat", "poll"] }
          }
        }
      ]
    },
    "output": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["head_sha", "pr", "plan_kind", "merge_base", "changed_paths", "map_sha", "full_set", "entries", "build", "plan_log"],
          "properties": {
            "kind": { "enum": ["suite.plan", "main.plan"] },
            "code": { "const": 100 },
            "node": { "enum": ["N-23", "N-26"] },
            "head_sha": { "$ref": "#/$defs/sha40" },
            "pr": { "type": "integer", "minimum": 0 },
            "plan_kind": { "type": "string", "enum": ["pr", "main"] },
            "merge_base": { "$ref": "#/$defs/sha40" },
            "changed_paths": { "type": "array", "items": { "type": "string" } },
            "map_sha": { "$ref": "#/$defs/sha40" },
            "full_set": { "type": "boolean" },
            "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
            "build": {
              "type": "object",
              "required": ["job", "number", "url"],
              "properties": {
                "job": { "const": "coq-gate" },
                "number": { "type": "integer", "minimum": 0, "description": "0 while planned and not yet triggered" },
                "url": { "type": "string" }
              }
            },
            "plan_log": { "type": "string" }
          }
        }
      ]
    },
    "refused": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["head_sha", "pr", "reason"],
          "properties": {
            "kind": { "enum": ["plan.refused", "plan.blocked", "plan.superseded"] },
            "code": { "enum": [412, 423, 410] },
            "node": { "enum": ["N-23", "N-26", "N-07"] },
            "head_sha": { "$ref": "#/$defs/sha40" },
            "pr": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string", "enum": ["fork", "no-image", "planner-error", "diff-unavailable", "jenkins-queue", "no-job-registered", "no-namespace-ready", "no-image-record", "newer-head"] },
            "detail": { "type": "string", "maxLength": 2000 },
            "plan_log": { "type": "string" }
          }
        }
      ]
    }
  }
}

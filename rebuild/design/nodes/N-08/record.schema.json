{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rebuild/design/nodes/N-08/record.schema.json",
  "title": "N-08 Gate check: input and output records",
  "description": "Input forge.snapshot (../N-04/record.schema.json#/$defs/forge_snapshot, not repeated); output gate.verdict. Base shape as in ../N-07/record.schema.json#/$defs/base and ../../shared/state-store.xml#table-records. Times are UTC strings 2006-01-02T15:04:05Z. Written 2026-10-14 UTC by the G2 spec-author seat.",
  "oneOf": [
    { "$ref": "../N-04/record.schema.json#/$defs/forge_snapshot" },
    { "$ref": "#/$defs/gate_verdict" }
  ],
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "base": { "$ref": "../N-07/record.schema.json#/$defs/base" },
    "gate_verdict": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "kind": { "const": "gate.verdict" },
        "code": { "type": "integer", "enum": [100, 201, 422, 500] },
        "node": { "const": "N-08" },
        "idempotency_key": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{40}:(green|red|pending|missing|superseded)$" },
        "pr": { "type": "integer", "minimum": 1 },
        "ticket": { "$ref": "#/$defs/ticket" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "verdict": { "type": "string", "enum": ["green", "red", "pending", "missing", "superseded"] },
        "reason": { "type": "string", "enum": ["status", "draft", "fork", "no-ticket", "absent-timeout", "pending-timeout", "error-x3", "superseded"] },
        "gate_url": { "type": "string" },
        "gate_page_url": { "type": "string" },
        "main_sha": { "$ref": "#/$defs/sha" },
        "status_updated_at": { "$ref": "#/$defs/at" },
        "snapshot_seq": { "type": "integer", "minimum": 1, "description": "N-04 seq of the snapshot judged" }
      },
      "required": ["idempotency_key", "pr", "head_sha", "verdict", "reason", "main_sha", "snapshot_seq"],
      "allOf": [
        { "if": { "properties": { "verdict": { "const": "green" } } }, "then": { "properties": { "code": { "const": 201 } } } },
        { "if": { "properties": { "verdict": { "const": "red" } } }, "then": { "properties": { "code": { "const": 422 } } } },
        { "if": { "properties": { "verdict": { "const": "missing" } } }, "then": { "properties": { "code": { "const": 500 } } } },
        { "if": { "properties": { "verdict": { "enum": ["pending", "superseded"] } } }, "then": { "properties": { "code": { "const": 100 } } } }
      ]
    }
  }
}

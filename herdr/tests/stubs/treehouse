#!/usr/bin/env bash
# stubs/treehouse - stands in for the treehouse CLI inside the suite, so a case never leases, resets or returns a real slot of
# the host's pool (WO-20261010-a429). On PATH from world_up like the compaction-guard stub. The pool is a directory under the
# case's private HOME ($TREEHOUSE_STUB_ROOT overrides): pool.json holds one entry per leased slot in the shape the real
# `treehouse status --json` prints (name, path, status, flavor, lease_id, lease_holder, leased_at, processes), slots/<n> the
# directories. Only the verbs seat.sh uses exist:
#   get --lease [--lease-holder H] [--no-fetch] [--json]   lowest free slot number, a directory, an entry; prints the entry (--json) or the path
#   status [--json]                                        the leased entries; --json is the array, otherwise one line per slot
#   return <path> [--force] [--if-lease-holder H]          removes the entry and the directory; exit 1 when the path is not leased or the holder differs
# `processes` is live, as in the real tool (WO-20261011-36d7): every process on the host whose cwd is the slot or under it, read
# from /proc as [{pid,name}], this call included when the caller stands in the slot. `return --force` ends them first (SIGTERM, then
# SIGKILL), which is what the real tool does to a shell parked in a slot ("Terminated lingering processes"), so a case can prove
# a process survived because seat.sh refused to return, and that it was named before the return.
# TREEHOUSE_STUB_ORIGIN=<bare repo> makes `get` clone it into the slot and detach at origin/main, which is what a fresh slot of the
# real pool is (WO-20261011-c077: seat.sh checks the ticket branch out there, so the case needs a repository to check out in).
# Unset, a slot is an empty directory, as before.
# TREEHOUSE_STUB_FAIL=1 makes `get` exit 1 with a pool-exhausted message, to prove a failed acquire builds nothing.
# Every call's argv is appended to $TREEHOUSE_STUB_LOG when it is set, so a case can count and read them.
root="${TREEHOUSE_STUB_ROOT:-$HOME/.treehouse-stub}"; db="$root/pool.json"
mkdir -p "$root/slots"; [ -f "$db" ] || echo '[]' > "$db"
[ -z "${TREEHOUSE_STUB_LOG:-}" ] || printf '%s\n' "$*" >> "$TREEHOUSE_STUB_LOG"
# procs_of PATH: JSON [{pid,name}] of the processes whose cwd is PATH or below it.
procs_of() {
  local d c out="[]"
  for d in /proc/[0-9]*; do
    c="$(readlink "$d/cwd" 2>/dev/null)" || continue
    case "$c" in "$1" | "$1"/*) out="$(jq -c --argjson p "${d#/proc/}" --arg n "$(cat "$d/comm" 2>/dev/null)" '. + [{pid:$p,name:$n}]' <<<"$out")" ;; esac
  done
  printf '%s' "$out"
}
status_json() {
  local m="{}" p
  while IFS= read -r p; do [ -n "$p" ] || continue; m="$(jq -c --arg p "$p" --argjson v "$(procs_of "$p")" '.[$p] = $v' <<<"$m")"; done < <(jq -r '.[].path' "$db")
  jq -c --argjson m "$m" 'map(.processes = ($m[.path] // []))' "$db"
}
save() { printf '%s\n' "$1" > "$db.tmp" && mv "$db.tmp" "$db"; }
verb="${1:-}"; [ $# -eq 0 ] || shift
case "$verb" in
  get)
    lease=0; json=0; holder="${TREEHOUSE_LEASE_HOLDER:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --lease) lease=1 ;; --json) json=1 ;; --no-fetch) ;;
        --lease-holder) holder="${2:?--lease-holder needs a value}"; shift ;;
        *) echo "stub treehouse: get: unknown flag $1" >&2; exit 2 ;;
      esac
      shift
    done
    [ "$lease" = 1 ] || { echo "stub treehouse: get without --lease would open a subshell" >&2; exit 2; }
    [ "${TREEHOUSE_STUB_FAIL:-0}" != 1 ] || { echo "stub treehouse: no free worktree in the pool" >&2; exit 1; }
    n="$(jq -r '[.[].name | tonumber] as $u | first(range(1; 100) | select(. as $i | any($u[]; . == $i) | not))' "$db")"
    path="$root/slots/$n"; mkdir -p "$path"
    if [ -n "${TREEHOUSE_STUB_ORIGIN:-}" ]; then
      git clone -q "$TREEHOUSE_STUB_ORIGIN" "$path" && git -C "$path" checkout -q --detach origin/main \
        || { echo "stub treehouse: could not clone $TREEHOUSE_STUB_ORIGIN into $path" >&2; rm -rf "$path"; exit 1; }
    fi
    id="$(printf '%s' "$holder-$n-$(date -u +%s%N)" | sha256sum | cut -c1-32)"
    entry="$(jq -nc --arg n "$n" --arg p "$path" --arg i "$id" --arg h "$holder" --arg at "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" \
      '{name:$n,path:$p,status:"leased",flavor:"git",lease_id:$i,lease_holder:$h,leased_at:$at,processes:[]}')"
    save "$(jq -c --argjson e "$entry" '. + [$e]' "$db")"
    if [ "$json" = 1 ]; then echo "$entry"; else echo "$path"; fi ;;
  status)
    if [ "${1:-}" = --json ]; then status_json
    else jq -r '.[] | "\(.name)\t\(.status)\t\(.path)  (held by \(.lease_holder))"' "$db"; fi ;;
  return)
    path="${1:?return needs a path}"; shift; holder=""; force=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) force=1 ;; --if-lease-holder) holder="${2:?--if-lease-holder needs a value}"; shift ;;
        *) echo "stub treehouse: return: unknown flag $1" >&2; exit 2 ;;
      esac
      shift
    done
    row="$(jq -c --arg p "$path" 'first(.[] | select(.path == $p)) // empty' "$db")"
    [ -n "$row" ] || { echo "stub treehouse: $path is not a leased worktree" >&2; exit 1; }
    [ -z "$holder" ] || [ "$(jq -r .lease_holder <<<"$row")" = "$holder" ] \
      || { echo "stub treehouse: $path is held by $(jq -r .lease_holder <<<"$row"), not $holder" >&2; exit 1; }
    if [ "$force" = 1 ]; then
      for pid in $(procs_of "$path" | jq -r '.[].pid'); do [ "$pid" = "$$" ] || kill "$pid" 2>/dev/null || true; done
      sleep 0.2
      for pid in $(procs_of "$path" | jq -r '.[].pid'); do [ "$pid" = "$$" ] || kill -9 "$pid" 2>/dev/null || true; done
    fi
    save "$(jq -c --arg p "$path" 'map(select(.path != $p))' "$db")"
    rm -rf "$path" ;;
esac
exit 0

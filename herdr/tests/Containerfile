# herdr/tests/Containerfile - the seat suite image (SPEC-04 s-testing, Spike 11).
# A scratch herdr server runs headless inside this container; the herdr binary itself is bind-mounted from the host
# (HERDR_BIN_PATH, a static x86-64 executable) so the suite tests the exact release the fleet runs, never a copy that
# drifts. Everything the scripts need (bash, jq, git, python3 with jsonschema, procps for the audit's /proc walk, a
# shell for the panes) is installed here at build time so every case runs with --network=none.
#
# Pinned by digest (Rule 15). Repin deliberately:
#   podman pull docker.io/library/debian:stable-slim
#   podman image inspect docker.io/library/debian:stable-slim --format '{{index .RepoDigests 0}}'
FROM docker.io/library/debian@sha256:520c7157b4b1c3c46fa56bac0e748ea21d60956c0512b300e3b16d8757f68e2d
# debian:stable-slim, pulled 2026-09-21 (same digest as ~/tools/bearings-v2/tests/Containerfile)
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash jq git python3 python3-jsonschema ca-certificates procps ncurses-bin \
  && rm -rf /var/lib/apt/lists/*
RUN git config --system user.email "coq-tests@example.invalid" \
  && git config --system user.name "coq seat suite" \
  && git config --system --add safe.directory "*" \
  && git config --system init.defaultBranch main

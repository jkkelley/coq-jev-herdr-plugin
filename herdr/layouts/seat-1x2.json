{
  "id": "seat-1x2",
  "grid": "1x2",
  "panes": [
    {
      "slot": "a",
      "kind": "agent",
      "label": "${MODEL} - ${effort} - ${ticket} ${seat}",
      "command": ""
    },
    {
      "slot": "b",
      "kind": "monitor",
      "label": "MONITOR - ${name}",
      "command": "while :; do clear; ${repo}/events/bin/event.sh tail; sleep 15; done"
    },
    {
      "slot": "c",
      "kind": "test",
      "label": "test - herdr - ${name}",
      "command": "cd ${repo} && clear",
      "split": {
        "from": "b",
        "direction": "down",
        "ratio": 0.4
      }
    }
  ]
}

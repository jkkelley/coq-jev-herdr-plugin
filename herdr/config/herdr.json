{
  "schema_version": "1.0.0",
  "session": "stable",
  "workspace_label": "coq",
  "state_dir": "~/.local/state/coq",
  "prompt_regex": "[$%>❯] *$",
  "prompt_timeout_ms": 15000,
  "agent_start_timeout_ms": 30000,
  "down_wait_seconds": 3,
  "down_kill_tries": 3,
  "down_kill_wait_seconds": 2,
  "retire_poll_seconds": 10,
  "nudge_wait_seconds": 180,
  "nudge_settle_seconds": 10,
  "session_wait_seconds": 10,
  "claude_sessions_dir": "~/.claude/sessions",
  "guard_watch_interval_seconds": 15,
  "max_agents": 8,
  "bringup_gate": true,
  "require_guard": true,
  "monitor_seat": "monitor",
  "shells": ["sh", "bash", "dash", "zsh", "fish", "ksh"],
  "runtime_bin": {
    "claude": "claude",
    "codex": "codex"
  },
  "keys": {
    "interrupt": "C-c",
    "escape": "Escape",
    "down": "Down",
    "enter": "Enter"
  },
  "control_plane": {
    "health_url": null
  },
  "belt": {
    "slot": "runner",
    "status": "${repo}/factory/bin/route.sh status",
    "settle_seconds": 20
  },
  "break_glass": {
    "ttl_seconds": 600,
    "hook_pre_timeout_seconds": 10,
    "hook_post_timeout_seconds": 30,
    "bearings_tier": "stable"
  },
  "resume_checkpoint": {
    "hook_timeout_seconds": 10
  },
  "halt_flag": "${state_dir}/HALT",
  "monitor_task": "watch the event log, the seats and the guard; wake a waiting seat on status change with one line; raise owner notifications for 423 and any 5xx; run cleanup every tick",
  "watches": {
    "architect_agent": "architect",
    "turn_poll_seconds": 15,
    "record_poll_seconds": 10,
    "record_kinds": [
      "pr.opened",
      "test.passed",
      "test.failed",
      "review.passed",
      "review.changes",
      "merged",
      "merge.conflict",
      "blocked",
      "test",
      "review"
    ],
    "compliance_agent": "compliance-officer",
    "patrol_seconds": 60
  },
  "supervisor": {
    "step_timeout_seconds": 120,
    "herdr_unit": "herdr-stable.service",
    "herdr_wait_seconds": 30,
    "podman": true,
    "bearings": {
      "enabled": true,
      "tier": "stable",
      "script": "${repo}/tools/bearings/scripts/bearings.sh"
    },
    "reseat": {
      "enabled": true,
      "grace_seconds": 20,
      "max_per_window": 3,
      "window_seconds": 1800,
      "down_lock_seconds": 300,
      "up_seconds": 90
    },
    "timeouts": {
      "herdr_kill_after_seconds": 5,
      "step_kill_after_seconds": 10,
      "herdr_list_seconds": 15,
      "herdr_probe_seconds": 5,
      "herdr_query_seconds": 10,
      "systemctl_seconds": 30,
      "podman_seconds": 30,
      "podman_migrate_seconds": 60,
      "bearings_status_seconds": 30
    }
  }
}

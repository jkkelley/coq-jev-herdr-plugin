{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coq/factory/schema/routes.schema.json",
  "title": "routes", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "description", "max_attempts", "routes"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "description": { "type": "string" }, "max_attempts": { "const": 3 },
    "routes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["match", "do"],
      "allOf": [ { "if": { "properties": { "do": { "const": "ignore" } }, "required": ["do"] }, "then": { "not": { "required": ["to"] } }, "else": { "required": ["to"] } } ],
      "properties": {
        "match": { "type": "object", "additionalProperties": false, "properties": { "kind": { "type": "string" }, "code": { "type": "integer" }, "code_gte": { "type": "integer" }, "attempt": { "type": "integer" }, "attempt_lt": { "type": "integer" }, "escalations": { "type": "integer" }, "escalations_lt": { "type": "integer" } } },
        "do": { "enum": ["enqueue", "wake", "seat", "escalate", "notify_owner", "break-glass", "ignore", "none"] },
        "to": { "enum": ["interface-agent", "orchestrator", "architect", "worker", "tester", "reviewer", "merger", "verifier", "player", "monitor"] },
        "down": { "enum": ["tester", "reviewer", "merger", "verifier"], "description": "the role whose seat for this ticket is taken down by seat.sh --down once the row's own action has been tried" },
        "with": { "enum": ["ticket", "pr", "record", "verify", "merge-main"] }, "code": { "type": "integer" }, "priority_from": { "type": "string" }, "line": { "enum": ["done", "decision"] },
        "when": { "enum": ["head_current", "heads_match"], "description": "a gate.sh predicate: 0 routes the record, 1 holds it (a receipt that says why and nothing else), other is a 500" },
        "supersede": { "type": "boolean", "description": "the wake line names the older head gate.sh says this record replaces" }
      } } }
  }
}

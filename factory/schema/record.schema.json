{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coq/factory/schema/record.schema.json",
  "title": "factory record",
  "description": "The only thing one seat hands another. Shape follows rime.a2a.v1 (bearings-v2) with the event log's observation shape. No prose field is routed on; code and kind are.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "at", "ticket", "seat", "role", "kind", "code", "attempt"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9]{3}-[a-z0-9]{5}$" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ticket": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9a-f]{4}$" },
    "seat": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "role": { "enum": ["interface-agent", "orchestrator", "architect", "worker", "tester", "reviewer", "merger", "player", "monitor"] },
    "kind": { "enum": ["request.forwarded", "request.accepted", "request.rejected", "ticket.cut", "work.started", "pr.opened", "test.passed", "test.failed", "review.passed", "review.changes", "merged", "merge.conflict", "verified", "rejected", "blocked", "escalated", "seat.up", "seat.down", "compaction", "note"] },
    "code": { "type": "integer", "minimum": 100, "maximum": 599 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "pr": { "type": ["integer", "null"] },
    "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "observations": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["saw", "expected"], "properties": { "path": { "type": "string" }, "line": { "type": "integer" }, "saw": { "type": "string", "maxLength": 240 }, "expected": { "type": "string", "maxLength": 240 } } } },
    "repro": { "type": ["string", "null"], "maxLength": 240, "description": "one command that reproduces a failure" },
    "note": { "type": "string", "maxLength": 240 }
  }
}
